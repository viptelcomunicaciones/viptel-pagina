---
import ProjectsTagView from '@/components/projects/views/ProjectsTagView.astro';
import NotFoundView from '@/components/pages/views/NotFoundView.astro';
import { defaultLocale } from '@/i18n';
import {
  collectProjectTags,
  collectTopProjectTags,
  findTagBySlug,
  getTagName,
  getVisibleProjects,
  PROJECT_TAG_CLOUD_LIMIT,
} from '@/lib/projects';

export const prerender = false;

const locale = defaultLocale;
const slug = Astro.params.tag ?? '';
const allProjects = await getVisibleProjects(locale);
const tags = collectProjectTags(allProjects);
const tag = findTagBySlug(slug, tags);

if (!tag) {
  Astro.response.status = 404;
}

const projects = tag
  ? allProjects.filter((p) => (p.tags ?? []).some((t) => getTagName(t) === tag))
  : [];
const topTags = tag ? collectTopProjectTags(allProjects, PROJECT_TAG_CLOUD_LIMIT) : [];
const visibleTags = tag
  ? topTags.includes(tag)
    ? topTags
    : [tag, ...topTags.slice(0, PROJECT_TAG_CLOUD_LIMIT - 1)]
  : [];
---

{
  tag ? (
    <ProjectsTagView locale={locale} tag={tag} projects={projects} visibleTags={visibleTags} />
  ) : (
    <NotFoundView locale={locale} />
  )
}

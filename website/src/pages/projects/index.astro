---
import PageLayout from '@/layouts/PageLayout.astro'
import { Hero } from '@/components/hero'
import Badge from '@/components/ui/data-display/Badge/Badge.astro'
import Icon from '@/components/ui/primitives/Icon/Icon.astro'
import { t, defaultLocale } from '@/i18n'
import { getAllProjects } from '@/lib/payload'

export const prerender = false

const locale = defaultLocale
const projects = await getAllProjects(locale)
---

<PageLayout title={t('projects.metaTitle', locale)} description={t('projects.metaDescription', locale)} eagerReveal footerBackground="secondary">
  <Hero layout="centered" size="sm" class="isolate" showHeroHalo>
    <Badge slot="badge" variant="brand" pill>
      <Icon name="layers" size="sm" />
      {t('projects.heroBadge', locale)}
    </Badge>
    <h1 slot="title">{t('projects.title', locale)}</h1>
    <p slot="description">{t('projects.heroDescription', locale)}</p>
  </Hero>

  {projects.length > 0 && (
    <section class="py-(--space-section-md) bg-background-secondary border-t border-border">
      <div class="mx-auto max-w-6xl px-6">
        <div class="grid gap-6 md:grid-cols-2">
          {projects.map((project, i) => (
            <a
              href={`/${locale === defaultLocale ? '' : locale + '/'}projects/${project.slug}`}
              class="group bg-background rounded-xl border border-border overflow-hidden hover:border-brand-500/40 hover:shadow-md transition-all duration-200 hover:-translate-y-1 flex flex-col"
              data-reveal data-reveal-delay={(i % 2) || undefined}
            >
              <div class="p-6 flex flex-col flex-1">
                <div class="flex items-start justify-between gap-4 mb-3">
                  <h2 class="font-display text-lg font-bold text-foreground group-hover:text-brand-500 transition-colors">{project.title}</h2>
                  <Icon name="arrow-up-right" size="sm" class="text-foreground-muted group-hover:text-brand-500 transition-colors shrink-0" />
                </div>
                {project.description && <p class="text-sm text-foreground-muted leading-relaxed mb-4 flex-1">{project.description}</p>}
                <div class="flex flex-wrap items-center gap-2">
                  {project.client && <span class="text-xs text-foreground-muted">{project.client}</span>}
                  {project.year && <span class="text-xs text-foreground-muted">{project.year}</span>}
                  {project.tags && project.tags.length > 0 && (
                    <div class="flex flex-wrap gap-1.5 ml-auto">
                      {project.tags.map((t) => (
                        <span class="inline-flex items-center rounded-full bg-transparent px-2 py-0.5 text-xs font-medium text-brand-700 dark:text-brand-400 ring-1 ring-inset ring-brand-500/40">{t.tag}</span>
                      ))}
                    </div>
                  )}
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</PageLayout>

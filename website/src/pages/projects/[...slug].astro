---
import PageLayout from '@/layouts/PageLayout.astro';
import ProjectLayout from '@/layouts/ProjectLayout.astro';
import ProjectsArchiveView from '@/components/projects/views/ProjectsArchiveView.astro';
import NotFoundView from '@/components/pages/views/NotFoundView.astro';
import { defaultLocale } from '@/i18n';
import { resolveProjectArchive, PROJECTS_PER_PAGE } from '@/lib/projects';
import { payload } from '@/lib/payload-client';
import { getResolvedSiteConfig } from '@/lib/site-config';

export const prerender = false;

const resolvedConfig = await getResolvedSiteConfig(defaultLocale);
const limit = resolvedConfig.projects?.perPage ?? PROJECTS_PER_PAGE;

const { slug } = Astro.params;
const segments = slug ? slug.split('/').filter(Boolean) : [];
const currentPage = Math.max(1, Number(Astro.url.searchParams.get('page')) || 1);
const archive =
  segments.length > 0
    ? await resolveProjectArchive(segments, defaultLocale, currentPage, limit)
    : ({ kind: 'not-found' } as const);

const is404 = archive.kind === 'not-found';
if (is404) {
  Astro.response.status = 404;
}

const project = archive.kind === 'project' ? archive.project! : null;
const projectMetaImage =
  project?.meta?.image && typeof project.meta.image === 'object' && project.meta.image.url
    ? payload.resolveMediaUrl(project.meta.image.url)
    : project?.coverImage && typeof project.coverImage === 'object' && project.coverImage.url
      ? payload.resolveMediaUrl(project.coverImage.url)
      : undefined;
---

{
  is404 ? (
    <NotFoundView locale={defaultLocale} />
  ) : project ? (
    <PageLayout
      title={project.meta?.title || project.title}
      description={project.meta?.description || project.description || project.title}
      image={projectMetaImage}
      showScrollProgress={project.toc === 'enabled' || project.toc !== 'disabled'}
      noindex={project.meta?.noindex ?? undefined}
      nofollow={project.meta?.nofollow ?? undefined}
      canonicalUrl={project.meta?.canonicalUrl ?? undefined}
    >
      <ProjectLayout project={project} locale={defaultLocale} />
    </PageLayout>
  ) : (
    <ProjectsArchiveView archive={archive} currentPage={currentPage} locale={defaultLocale} />
  )
}
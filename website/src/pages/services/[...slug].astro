---
import ServiceView from '@/components/pages/views/ServiceView.astro';
import NotFoundView from '@/components/pages/views/NotFoundView.astro';
import { payload } from '@/lib/payload-client';
import type { Service } from '@/lib/payload-types';
import { defaultLocale } from '@/i18n';

export const prerender = false;

const { slug } = Astro.params;
const locale = defaultLocale;
const querySlug = slug ? (slug.includes('/') ? slug.split('/').pop()! : slug) : '';
const service = querySlug ? await payload.services().getBySlug(querySlug, locale) : null;

if (!service) {
  Astro.response.status = 404;
}

let parentService = null;
let childrenServices: Service[] = [];

if (service) {
  if (service.parent) {
    const parentSlug =
      typeof service.parent === 'object' && service.parent !== null
        ? (service.parent as Service).slug
        : null;
    if (parentSlug) {
      parentService = await payload.services().getBySlug(parentSlug, locale);
    }
  } else {
    childrenServices = await payload.services().getByParent(service.id, locale);
  }
}
---

{
  !service ? (
    <NotFoundView locale={locale} />
  ) : (
    <ServiceView
      service={service}
      parentService={parentService}
      childrenServices={childrenServices}
      locale={locale}
    />
  )
}

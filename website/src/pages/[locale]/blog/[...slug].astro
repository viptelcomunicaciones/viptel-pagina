---
import PageLayout from '@/layouts/PageLayout.astro';
import PostLayout from '@/layouts/PostLayout.astro';
import BlogArchiveView from '@/components/blog/views/BlogArchiveView.astro';
import NotFoundView from '@/components/pages/views/NotFoundView.astro';
import { defaultLocale, isValidLocale } from '@/i18n';
import { resolveBlogArchive, getTagName, BLOG_POSTS_PER_PAGE } from '@/lib/blog';
import { payload } from '@/lib/payload-client';
import { createBlogPostSchema } from '@/lib/schema';
import { getResolvedSiteConfig } from '@/lib/site-config';
import siteConfig from '@/config/site.config';

export const prerender = false;

const { locale = defaultLocale, slug } = Astro.params;
const validLocale = isValidLocale(locale);
const effectiveLocale = validLocale ? locale : defaultLocale;

const resolvedConfig = await getResolvedSiteConfig(effectiveLocale);
const limit = resolvedConfig.blog?.postsPerPage ?? BLOG_POSTS_PER_PAGE;

const segments = validLocale && slug ? slug.split('/').filter(Boolean) : [];
const currentPage = Math.max(1, Number(Astro.url.searchParams.get('page')) || 1);
const archive =
  segments.length > 0
    ? await resolveBlogArchive(segments, effectiveLocale, currentPage, limit)
    : ({ kind: 'not-found' } as const);

const is404 = !validLocale || archive.kind === 'not-found';
if (is404) {
  Astro.response.status = 404;
}

const post = archive.kind === 'post' ? archive.post! : null;
const postMetaImage =
  post?.meta?.image && typeof post.meta.image === 'object' && post.meta.image.url
    ? payload.resolveMediaUrl(post.meta.image.url)
    : post?.heroImage && typeof post.heroImage === 'object' && post.heroImage.url
      ? payload.resolveMediaUrl(post.heroImage.url)
      : undefined;

const primaryAuthor = post?.populatedAuthors?.[0];
const postAuthor = primaryAuthor?.name || resolvedConfig.name;
const postAuthorAvatarUrl =
  primaryAuthor?.avatarUrl ? payload.resolveMediaUrl(primaryAuthor.avatarUrl) : undefined;
const postAuthorRoleTitle = primaryAuthor?.roleTitle || undefined;
const postAuthorSocialLinks =
  primaryAuthor?.socialLinks && primaryAuthor.socialLinks.length > 0
    ? primaryAuthor.socialLinks
        .map((s: { url?: string }) => s.url)
        .filter((u): u is string => Boolean(u))
    : undefined;

const postPublishedAt = post?.publishedAt
  ? new Date(post.publishedAt)
  : post?.createdAt
    ? new Date(post.createdAt)
    : new Date();
const postModifiedAt = post?.updatedAt ? new Date(post.updatedAt) : undefined;
const postTags = (post?.tags ?? []).map((t) => getTagName(t)).filter(Boolean);
const postSchemas = post
  ? [
      createBlogPostSchema({
        title: post.meta?.title || post.title,
        description: post.meta?.description || post.excerpt || post.title,
        url: new URL(Astro.url.pathname, Astro.site).toString(),
        image:
          postMetaImage ||
          (resolvedConfig.branding.logo.imageUrl
            ? `${resolvedConfig.url}${resolvedConfig.branding.logo.imageUrl}`
            : new URL(siteConfig.ogImage, Astro.site).toString()),
        datePublished: postPublishedAt,
        dateModified: postModifiedAt,
        author: {
          name: postAuthor,
          url: resolvedConfig.url,
          image: postAuthorAvatarUrl,
          jobTitle: postAuthorRoleTitle,
          sameAs: postAuthorSocialLinks,
        },
        publisher: {
          name: resolvedConfig.name,
          logoUrl: resolvedConfig.branding.logo.imageUrl
            ? `${resolvedConfig.url}${resolvedConfig.branding.logo.imageUrl}`
            : undefined,
        },
      }),
    ]
  : undefined;
---

{
  is404 ? (
    <NotFoundView locale={effectiveLocale} />
  ) : post ? (
    <PageLayout
      title={post.meta?.title || post.title}
      description={post.meta?.description || post.excerpt || post.title}
      image={postMetaImage}
      canonicalUrl={post.meta?.canonicalUrl || undefined}
      noindex={post.meta?.noindex ?? undefined}
      nofollow={post.meta?.nofollow ?? undefined}
      article={{
        publishedTime: postPublishedAt,
        modifiedTime: postModifiedAt,
        authors: [postAuthor],
        tags: postTags,
      }}
      extraSchemas={postSchemas}
    >
      <PostLayout post={post} locale={effectiveLocale} />
    </PageLayout>
  ) : (
    <BlogArchiveView archive={archive} currentPage={currentPage} locale={effectiveLocale} />
  )
}

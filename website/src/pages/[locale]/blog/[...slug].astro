---
import PageLayout from '@/layouts/PageLayout.astro'
import RichText from '@/components/blocks/RichText.astro'
import { defaultLocale } from '@/i18n'
import { payload } from '@/lib/payload-client'

export const prerender = false

const { locale = defaultLocale, slug } = Astro.params

if (!slug) {
  return Astro.redirect('/404')
}

const post = await payload.posts().getBySlug(slug, locale)

if (!post) {
  return Astro.redirect('/404')
}
---

<PageLayout title={post.title} description={post.excerpt || post.title}>
  <article class="py-[var(--space-section-md)]">
    <div class="mx-auto max-w-3xl px-6">
      {post.heroImage && typeof post.heroImage !== 'number' && post.heroImage.url && (
        <img src={payload.resolveMediaUrl(post.heroImage.url)} alt={post.heroImage.alt || post.title} class="w-full aspect-video object-cover rounded-xl mb-8 shadow-lg" />
      )}
      <h1 class="font-display text-4xl md:text-5xl font-bold text-foreground mb-4">{post.title}</h1>
      <div class="flex flex-wrap items-center gap-4 text-sm text-foreground-muted mb-8">
        {post.publishedAt && <time>{new Date(post.publishedAt).toLocaleDateString(locale === 'es' ? 'es-CO' : 'en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</time>}
        {post.populatedAuthors?.[0]?.name && <span>Por {post.populatedAuthors[0].name}</span>}
        {post.tags && post.tags.length > 0 && (
          <div class="flex flex-wrap gap-1.5">
            {post.tags.map((t) => (
              <span class="inline-flex items-center rounded-full bg-transparent px-2.5 py-0.5 text-xs font-medium text-brand-700 dark:text-brand-400 ring-1 ring-inset ring-brand-500/40">{t.tag}</span>
            ))}
          </div>
        )}
      </div>
      {post.excerpt && <p class="text-lg text-foreground-muted mb-8 leading-relaxed">{post.excerpt}</p>}
      <div class="prose prose-lg dark:prose-invert max-w-none">
        <RichText content={post.content} />
      </div>
    </div>
  </article>
</PageLayout>

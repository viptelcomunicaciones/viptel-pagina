---
import PageLayout from '@/layouts/PageLayout.astro'
import PostLayout from '@/layouts/PostLayout.astro'
import { defaultLocale, isValidLocale } from '@/i18n'
import { payload } from '@/lib/payload-client'

export const prerender = false

const { locale = defaultLocale, slug } = Astro.params

if (!isValidLocale(locale)) {
  return Astro.redirect('/404')
}

if (!slug) {
  return Astro.redirect('/404')
}

const post = await payload.posts().getBySlug(slug, locale)

if (!post) {
  return Astro.redirect('/404')
}
---

<PageLayout title={post.title} description={post.excerpt || post.title}>
  <PostLayout post={post} locale={locale} />
</PageLayout>

---
import BlogPageView from '@/components/blog/views/BlogPageView.astro';
import NotFoundView from '@/components/pages/views/NotFoundView.astro';
import { defaultLocale, isValidLocale } from '@/i18n';

export const prerender = false;

const { locale = defaultLocale } = Astro.params;
const validLocale = isValidLocale(locale);
const effectiveLocale = validLocale ? locale : defaultLocale;
const page = Number(Astro.params.page);
const isValidPage = validLocale && Number.isInteger(page) && page >= 2;

if (!isValidPage) {
  Astro.response.status = 404;
}
---

{
  isValidPage ? (
    <BlogPageView locale={effectiveLocale} page={page} />
  ) : (
    <NotFoundView locale={effectiveLocale} />
  )
}

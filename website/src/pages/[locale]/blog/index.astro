---
import BlogIndexView from '@/components/blog/views/BlogIndexView.astro';
import NotFoundView from '@/components/pages/views/NotFoundView.astro';
import { defaultLocale, isValidLocale } from '@/i18n';

export const prerender = false;

const { locale = defaultLocale } = Astro.params;
const validLocale = isValidLocale(locale);

if (!validLocale) {
  Astro.response.status = 404;
}
---

{validLocale ? <BlogIndexView locale={locale} /> : <NotFoundView locale={defaultLocale} />}

---
import BlogTagView from '@/components/blog/views/BlogTagView.astro';
import { defaultLocale, isValidLocale } from '@/i18n';
import { collectTags, findTagBySlug, getPublishedPosts, getTagName } from '@/lib/blog';

export const prerender = false;

// Locale-prefixed tag archive (`/<locale>/blog/tag/<slug>`). Resolved on demand.
const { locale = defaultLocale } = Astro.params;

if (!isValidLocale(locale)) {
  return Astro.redirect('/404');
}

const slug = Astro.params.tag ?? '';
const allPosts = await getPublishedPosts(locale);
const tags = collectTags(allPosts);
const tag = findTagBySlug(slug, tags);

if (!tag) {
  return Astro.redirect('/404');
}

const posts = allPosts.filter((p) => (p.tags ?? []).some((t) => getTagName(t) === tag));
---

<BlogTagView locale={locale} tag={tag} posts={posts} />

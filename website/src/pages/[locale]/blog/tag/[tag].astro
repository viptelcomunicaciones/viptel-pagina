---
import BlogTagView from '@/components/blog/views/BlogTagView.astro';
import NotFoundView from '@/components/pages/views/NotFoundView.astro';
import { defaultLocale, isValidLocale } from '@/i18n';
import { collectTags, findTagBySlug, getPublishedPosts, getTagName } from '@/lib/blog';

export const prerender = false;

const { locale = defaultLocale } = Astro.params;
const validLocale = isValidLocale(locale);
const effectiveLocale = validLocale ? locale : defaultLocale;
const slug = Astro.params.tag ?? '';
const allPosts = validLocale ? await getPublishedPosts(effectiveLocale) : [];
const tags = collectTags(allPosts);
const tag = validLocale ? findTagBySlug(slug, tags) : null;

if (!validLocale || !tag) {
  Astro.response.status = 404;
}

const posts = tag
  ? allPosts.filter((p) => (p.tags ?? []).some((t) => getTagName(t) === tag))
  : [];
---

{
  validLocale && tag ? (
    <BlogTagView locale={effectiveLocale} tag={tag} posts={posts} />
  ) : (
    <NotFoundView locale={effectiveLocale} />
  )
}

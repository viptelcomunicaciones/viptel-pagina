---
import ServiceView from '@/components/pages/views/ServiceView.astro';
import NotFoundView from '@/components/pages/views/NotFoundView.astro';
import { payload } from '@/lib/payload-client';
import type { Service } from '@/lib/payload-types';
import { getSecondaryLocales, isValidLocale, defaultLocale } from '@/i18n';

export const prerender = false;

export function getStaticPaths() {
  return getSecondaryLocales().map((locale) => ({ params: { locale } }));
}

const { slug, locale } = Astro.params as { slug: string; locale: string };
const validLocale = isValidLocale(locale);
const effectiveLocale = validLocale ? locale : defaultLocale;
const querySlug = validLocale && slug ? (slug.includes('/') ? slug.split('/').pop()! : slug) : '';
const service = querySlug ? await payload.services().getBySlug(querySlug, effectiveLocale) : null;

if (!validLocale || !service) {
  Astro.response.status = 404;
}

let parentService = null;
let childrenServices: Service[] = [];

if (service) {
  if (service.parent) {
    const parentSlug =
      typeof service.parent === 'object' && service.parent !== null
        ? (service.parent as Service).slug
        : null;
    if (parentSlug) {
      parentService = await payload.services().getBySlug(parentSlug, effectiveLocale);
    }
  } else {
    childrenServices = await payload.services().getByParent(service.id, effectiveLocale);
  }
}
---

{
  !validLocale || !service ? (
    <NotFoundView locale={effectiveLocale} />
  ) : (
    <ServiceView
      service={service}
      parentService={parentService}
      childrenServices={childrenServices}
      hrefPrefix={`/${locale}/services`}
      locale={locale}
    />
  )
}

---
import PageLayout from '@/layouts/PageLayout.astro'
import BlockRenderer from '@/components/blocks/BlockRenderer.astro'
import HeroBlock from '@/components/blocks/HeroBlock.astro'
import { payload } from '@/lib/payload-client'
import { isValidLocale, defaultLocale } from '@/i18n'

export const prerender = false

const { locale, slug } = Astro.params

// In SSR this catch-all also intercepts root-level multi-segment URLs
// (`/terminos/uso` → locale=terminos, slug=uso). When the first segment is not
// a valid locale we fall back to resolving the full path as a CMS page in the
// default locale (served at the site root) before 404ing.
const isLocale = isValidLocale(locale)
const effectiveLocale = isLocale ? locale! : defaultLocale
// Para un locale válido (`/en/...`), el slug a consultar es solo `slug` — el
// locale se pasa por separado a getBySlug(). Para una ruta raíz de 2+ segmentos
// (`/terminos/uso` → locale=terminos, slug=uso) reconstruimos la ruta completa.
const pageSlug = isLocale ? (slug ?? '') : [locale, slug].filter(Boolean).join('/')
// Los redirects sí se guardan con el path completo (prefijo de locale incluido).
const redirectFrom = isLocale ? `/${locale}/${slug ?? ''}` : `/${pageSlug}`

const redirect = await payload.redirects().get(redirectFrom)
if (redirect) {
  const target = typeof redirect.to === 'string' ? redirect.to : `/${(redirect.to as any)?.slug || ''}`
  return Astro.redirect(target, redirect.type === '301' ? 301 : 302)
}

const page = await payload.pages().getBySlug(pageSlug, effectiveLocale)
if (!page) {
  return Astro.redirect('/404')
}
---

<PageLayout title={page.meta?.title || page.title} description={page.meta?.description || page.title}>
  {page.hero && <HeroBlock hero={page.hero} locale={effectiveLocale} />}
  <BlockRenderer layout={page.layout} locale={effectiveLocale} />
</PageLayout>

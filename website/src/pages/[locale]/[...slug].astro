---
import PageLayout from '@/layouts/PageLayout.astro'
import BlockRenderer from '@/components/blocks/BlockRenderer.astro'
import HeroBlock from '@/components/blocks/HeroBlock.astro'
import { payload } from '@/lib/payload-client'

export const prerender = false

const { locale, slug } = Astro.params

if (!slug || !locale) {
  return Astro.redirect('/404')
}

// Check CMS redirects first
const redirect = await payload.redirects().get(`/${locale}/${slug}`)
if (redirect) {
  const target = typeof redirect.to === 'string' ? redirect.to : `/${(redirect.to as any)?.slug || ''}`
  return Astro.redirect(target, redirect.type === '301' ? 301 : 302)
}

const page = await payload.pages().getBySlug(slug, locale)

if (!page) {
  Astro.response.status = 404
}
---

{page ? (
  <PageLayout title={page.meta?.title || page.title} description={page.meta?.description  || page.title}>
    {page.hero && <HeroBlock hero={page.hero} locale={locale} />}
    <BlockRenderer layout={page.layout} locale={locale} />
  </PageLayout>
) : (
  <PageLayout title="Página no encontrada" description="La página que buscas no existe.">
    <div class="py-24 text-center mx-auto max-w-2xl px-6">
      <h1 class="font-display text-4xl font-bold text-foreground mb-4">404</h1>
      <p class="text-lg text-foreground-muted mb-8">La página que buscas no existe o ha sido movida.</p>
      <a href="/" class="inline-flex items-center rounded-md bg-brand-600 px-6 py-3 text-sm font-medium text-white hover:bg-brand-700">Volver al inicio</a>
    </div>
  </PageLayout>
)}

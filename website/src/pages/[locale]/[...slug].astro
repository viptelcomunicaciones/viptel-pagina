---
import PageLayout from '@/layouts/PageLayout.astro';
import BlockRenderer from '@/components/blocks/BlockRenderer.astro';
import RenderHero from '@/components/heros/RenderHero.astro';
import NotFoundView from '@/components/pages/views/NotFoundView.astro';
import { payload, redirectTarget } from '@/lib/payload-client';
import { isValidLocale, defaultLocale } from '@/i18n';

export const prerender = false;

const { locale, slug } = Astro.params;

const isLocale = isValidLocale(locale);
const effectiveLocale = isLocale ? locale! : defaultLocale;
const pageSlug = isLocale ? (slug ?? '') : [locale, slug].filter(Boolean).join('/');
const redirectFrom = isLocale ? `/${locale}/${slug ?? ''}` : `/${pageSlug}`;

if (pageSlug === 'home') return Astro.redirect(isLocale ? `/${effectiveLocale}` : '/', 301);

const redirect = await payload.redirects().get(redirectFrom);
if (redirect) {
  const { target, status } = redirectTarget(redirect);
  return Astro.redirect(target, status);
}

const page = await payload.pages().getBySlug(pageSlug, effectiveLocale);
if (!page) {
  Astro.response.status = 404;
}

const metaImage =
  page?.meta?.image && typeof page.meta.image === 'object' && page.meta.image.url
    ? payload.resolveMediaUrl(page.meta.image.url)
    : undefined;
---

{
  !page ? (
    <NotFoundView locale={effectiveLocale} />
  ) : (
    <PageLayout
      title={page.meta?.title || page.title}
      description={page.meta?.description || page.title}
      image={metaImage}
    >
      {page.hero && <RenderHero hero={page.hero} locale={effectiveLocale} />}
      <BlockRenderer layout={page.layout} locale={effectiveLocale} />
    </PageLayout>
  )
}

---
import ServicesOverviewView from '@/components/pages/views/ServicesOverviewView.astro';
import NotFoundView from '@/components/pages/views/NotFoundView.astro';
import { payload } from '@/lib/payload-client';
import type { Service } from '@/lib/payload-types';
import { getSecondaryLocales, isValidLocale, defaultLocale } from '@/i18n';

export function getStaticPaths() {
  return getSecondaryLocales().map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params;
const validLocale = isValidLocale(locale);

if (!validLocale) {
  Astro.response.status = 404;
}

const categories = validLocale ? await payload.services().getCategories(locale) : [];
const childrenMap: Record<string, Service[]> = {};
if (validLocale) {
  const childResults = await Promise.all(
    categories.map((cat) => payload.services().getByParent(cat.id, locale))
  );
  categories.forEach((cat, i) => {
    childrenMap[cat.id] = childResults[i];
  });
}
---

{
  validLocale ? (
    <ServicesOverviewView
      categories={categories}
      childrenMap={childrenMap}
      hrefPrefix={`/${locale}/services`}
      locale={locale}
    />
  ) : (
    <NotFoundView locale={defaultLocale} />
  )
}

---
import ContactView from '@/components/pages/views/ContactView.astro';
import NotFoundView from '@/components/pages/views/NotFoundView.astro';
import { getSecondaryLocales, isValidLocale, defaultLocale } from '@/i18n';

export function getStaticPaths() {
  return getSecondaryLocales().map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params;
const validLocale = isValidLocale(locale);

if (!validLocale) {
  Astro.response.status = 404;
}
---

{validLocale ? <ContactView locale={locale} /> : <NotFoundView locale={defaultLocale} />}

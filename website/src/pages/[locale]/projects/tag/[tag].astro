---
import ProjectsTagView from '@/components/projects/views/ProjectsTagView.astro';
import NotFoundView from '@/components/pages/views/NotFoundView.astro';
import { defaultLocale, isValidLocale } from '@/i18n';
import { getResolvedSiteConfig } from '@/lib/site-config';
import {
  collectProjectTags,
  collectTopProjectTags,
  findTagBySlug,
  getTagName,
  getVisibleProjects,
  PROJECT_TAG_CLOUD_LIMIT,
} from '@/lib/projects';

export const prerender = false;

const { locale = defaultLocale } = Astro.params;
const validLocale = isValidLocale(locale);
const effectiveLocale = validLocale ? locale : defaultLocale;

const resolvedConfig = await getResolvedSiteConfig(effectiveLocale);
const tagCloudLimit = resolvedConfig.projects?.tagCloudLimit ?? PROJECT_TAG_CLOUD_LIMIT;

const slug = Astro.params.tag ?? '';
const allProjects = validLocale ? await getVisibleProjects(effectiveLocale) : [];
const tags = collectProjectTags(allProjects);
const tag = validLocale ? findTagBySlug(slug, tags) : null;

if (!validLocale || !tag) {
  Astro.response.status = 404;
}

const projects = tag
  ? allProjects.filter((p) => (p.tags ?? []).some((t) => getTagName(t) === tag))
  : [];
const topTags = tag ? collectTopProjectTags(allProjects, tagCloudLimit) : [];
const visibleTags = tag
  ? topTags.includes(tag)
    ? topTags
    : [tag, ...topTags.slice(0, tagCloudLimit - 1)]
  : [];
---

{
  validLocale && tag ? (
    <ProjectsTagView
      locale={effectiveLocale}
      tag={tag}
      projects={projects}
      visibleTags={visibleTags}
    />
  ) : (
    <NotFoundView locale={effectiveLocale} />
  )
}

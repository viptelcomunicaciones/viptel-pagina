---
import ProjectsTagView from '@/components/projects/views/ProjectsTagView.astro';
import { defaultLocale, isValidLocale } from '@/i18n';
import {
  collectProjectTags,
  collectTopProjectTags,
  findTagBySlug,
  getTagName,
  getVisibleProjects,
  PROJECT_TAG_CLOUD_LIMIT,
} from '@/lib/projects';

export const prerender = false;

// Locale-prefixed tag archive (`/<locale>/projects/tag/<slug>`). Resolved on demand.
const { locale = defaultLocale } = Astro.params;

if (!isValidLocale(locale)) {
  return Astro.redirect('/404');
}

const slug = Astro.params.tag ?? '';
const allProjects = await getVisibleProjects(locale);
const tags = collectProjectTags(allProjects);
const tag = findTagBySlug(slug, tags);

if (!tag) {
  return Astro.redirect('/404');
}

const projects = allProjects.filter((p) => (p.tags ?? []).some((t) => getTagName(t) === tag));
const topTags = collectTopProjectTags(allProjects, PROJECT_TAG_CLOUD_LIMIT);
const visibleTags = topTags.includes(tag)
  ? topTags
  : [tag, ...topTags.slice(0, PROJECT_TAG_CLOUD_LIMIT - 1)];
---

<ProjectsTagView locale={locale} tag={tag} projects={projects} visibleTags={visibleTags} />

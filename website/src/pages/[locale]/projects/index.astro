---
import ProjectsIndexView from '@/components/projects/views/ProjectsIndexView.astro';
import { defaultLocale, isValidLocale } from '@/i18n';

export const prerender = false;

const { locale = defaultLocale } = Astro.params;

if (!isValidLocale(locale)) {
  return Astro.redirect('/404');
}
---

<ProjectsIndexView locale={locale} />

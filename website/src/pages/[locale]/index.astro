---
import HomeView from '@/components/pages/views/HomeView.astro';
import NotFoundView from '@/components/pages/views/NotFoundView.astro';
import PageLayout from '@/layouts/PageLayout.astro';
import BlockRenderer from '@/components/blocks/BlockRenderer.astro';
import RenderHero from '@/components/heros/RenderHero.astro';
import { payload, redirectTarget } from '@/lib/payload-client';
import { getSecondaryLocales, isValidLocale, defaultLocale } from '@/i18n';
import { resolveCatchallRoute, applyCatchallResponseHeaders } from '@/lib/catchall';
import type { Page } from '@/lib/payload-types';

export function getStaticPaths() {
  return getSecondaryLocales().map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params;

if (locale === 'home') return Astro.redirect('/', 301);

const isLocale = isValidLocale(locale);
let rootPage: Page | null = null;
let is404 = false;

if (!isLocale) {
  const result = await resolveCatchallRoute(`/${locale ?? ''}`, locale ?? '', defaultLocale);
  if (result.redirect) {
    return Astro.redirect(result.redirect.target, result.redirect.status);
  }
  applyCatchallResponseHeaders(Astro.response, {
    isError: result.isError,
    hasPage: Boolean(result.page),
  });
  rootPage = result.page;
  is404 = result.isError || !result.page;
} else {
  const redirect = await payload.redirects().get(`/${locale}`);
  if (redirect) {
    const { target, status } = redirectTarget(redirect);
    return Astro.redirect(target, status);
  }
}

const metaImage =
  rootPage?.meta?.image && typeof rootPage.meta.image === 'object' && rootPage.meta.image.url
    ? payload.resolveMediaUrl(rootPage.meta.image.url)
    : undefined;
---

{
  is404 ? (
    <NotFoundView locale={defaultLocale} />
  ) : rootPage ? (
    <PageLayout
      title={rootPage.meta?.title || rootPage.title}
      description={rootPage.meta?.description || rootPage.title}
      image={metaImage}
      headerStyle={rootPage.headerStyle}
      floatingVariant={rootPage.floatingVariant}
      hasDarkHero={rootPage.hero?.type === 'highImpact'}
      noindex={rootPage.meta?.noindex ?? undefined}
      nofollow={rootPage.meta?.nofollow ?? undefined}
      canonicalUrl={rootPage.meta?.canonicalUrl ?? undefined}
    >
      {rootPage.hero && <RenderHero hero={rootPage.hero} locale={defaultLocale} />}
      <BlockRenderer layout={rootPage.layout} locale={defaultLocale} />
    </PageLayout>
  ) : (
    <HomeView locale={locale} />
  )
}

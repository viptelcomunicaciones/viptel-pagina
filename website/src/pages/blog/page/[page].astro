---
import BlogPageView from '@/components/blog/views/BlogPageView.astro';
import NotFoundView from '@/components/pages/views/NotFoundView.astro';
import { defaultLocale } from '@/i18n';

export const prerender = false;

const locale = defaultLocale;
const page = Number(Astro.params.page);
const isValidPage = Number.isInteger(page) && page >= 2;

if (!isValidPage) {
  Astro.response.status = 404;
}
---

{isValidPage ? <BlogPageView locale={locale} page={page} /> : <NotFoundView locale={locale} />}

---
import BlogTagView from '@/components/blog/views/BlogTagView.astro';
import { defaultLocale } from '@/i18n';
import {
  collectTags,
  findTagBySlug,
  getPublishedPosts,
  getTagName,
} from '@/lib/blog';

export const prerender = false

// Default-locale tag archive (`/blog/tag/<slug>`). Resolved on demand.
const locale = defaultLocale

const slug = Astro.params.tag ?? ''
const allPosts = await getPublishedPosts(locale)
const tags = collectTags(allPosts)
const tag = findTagBySlug(slug, tags)

if (!tag) {
  return Astro.redirect('/404')
}

const posts = allPosts.filter((p) => (p.tags ?? []).some((t) => getTagName(t) === tag))
---

<BlogTagView locale={locale} tag={tag} posts={posts} />
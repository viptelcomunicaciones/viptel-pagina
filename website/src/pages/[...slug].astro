---
import PageLayout from '@/layouts/PageLayout.astro'
import BlockRenderer from '@/components/blocks/BlockRenderer.astro'
import HeroBlock from '@/components/blocks/HeroBlock.astro'
import Icon from '@/components/ui/primitives/Icon/Icon.astro'
import Badge from '@/components/ui/data-display/Badge/Badge.astro'
import Card from '@/components/ui/data-display/Card/Card.astro'
import Button from '@/components/ui/form/Button/Button.astro'
import { Hero } from '@/components/hero'
import { payload, redirectTarget } from '@/lib/payload-client'
import { t, defaultLocale } from '@/i18n'

export const prerender = false

const { slug } = Astro.params
const locale = defaultLocale

// /home es la fuente de datos de la landing — nunca una página pública.
if (slug === 'home') return Astro.redirect('/', 301)

let page = null
let is404 = false

if (slug) {
  const redirect = await payload.redirects().get(`/${slug}`)
  if (redirect) {
    const { target, status } = redirectTarget(redirect)
    return Astro.redirect(target, status)
  }
  page = await payload.pages().getBySlug(slug)
  if (!page) is404 = true
} else {
  is404 = true
}

const recoveryLinks = [
  { icon: 'layers', title: t('projects.title', locale), description: t('errors.projectsDesc', locale), href: '/projects' },
  { icon: 'book', title: t('blog.title', locale), description: t('errors.blogDesc', locale), href: '/blog' },
  { icon: 'mail', title: t('errors.contactTitle', locale), description: t('errors.contactDesc', locale), href: '/contact' },
]
---

{is404 || !page ? (
  <PageLayout title={t('errors.metaTitle', locale)} description={t('errors.metaDescription', locale)} noindex eagerReveal>
    <Hero layout="centered" size="sm">
      <Badge slot="badge" variant="brand" pill><Icon name="compass" size="sm" />{t('errors.badge', locale)}</Badge>
      <h1 slot="title">{t('errors.titleLead', locale)} <span class="text-brand-500">{t('errors.titleHighlight', locale)}</span></h1>
      <p slot="description">{t('errors.description', locale)}</p>
      <div slot="actions" class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <Button href="/" size="lg"><Icon name="arrow-left" size="sm" />{t('errors.backHome', locale)}</Button>
        <Button href="/blog" variant="brand-outline" size="lg">{t('errors.browseBlog', locale)}<Icon name="arrow-right" size="sm" /></Button>
      </div>
    </Hero>
    <section class="py-[var(--space-section-md)] bg-background-secondary border-t border-border">
      <div class="mx-auto max-w-6xl px-6">
        <div class="mb-8 text-center" data-reveal><h2 class="font-display text-3xl md:text-4xl font-bold text-foreground">{t('errors.tryInstead', locale)}</h2></div>
        <div class="grid gap-6 lg:grid-cols-3">
          {recoveryLinks.map((link, i) => (
            <Card hover href={link.href} class="group" data-reveal data-reveal-delay={i}>
              <div class="flex items-start gap-4">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-brand-500/20 to-brand-500/5 flex items-center justify-center text-brand-500 shrink-0"><Icon name={link.icon} size="sm" /></div>
                <div class="flex-1 min-w-0"><h3 class="text-base font-semibold text-foreground">{link.title}</h3><p class="text-sm text-foreground-muted leading-relaxed mt-1.5">{link.description}</p></div>
                <Icon name="arrow-up-right" size="sm" class="text-foreground-muted group-hover:text-brand-500 transition-colors shrink-0" />
              </div>
            </Card>
          ))}
        </div>
      </div>
    </section>
  </PageLayout>
) : (
  <PageLayout title={page.meta?.title || page.title} description={page.meta?.description || page.title}>
    {page.hero && <HeroBlock hero={page.hero} locale={locale} />}
    <BlockRenderer layout={page.layout} locale={locale} />
  </PageLayout>
)}

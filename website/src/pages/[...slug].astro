---
import PageLayout from '@/layouts/PageLayout.astro';
import BlockRenderer from '@/components/blocks/BlockRenderer.astro';
import RenderHero from '@/components/heros/RenderHero.astro';
import NotFoundView from '@/components/pages/views/NotFoundView.astro';
import { payload, redirectTarget } from '@/lib/payload-client';
import { defaultLocale } from '@/i18n';

export const prerender = false;

const { slug } = Astro.params;
const locale = defaultLocale;

// /home es la fuente de datos de la landing — nunca una página pública.
if (slug === 'home') return Astro.redirect('/', 301);

let page = null;
let is404 = false;

if (slug) {
  const redirect = await payload.redirects().get(`/${slug}`);
  if (redirect) {
    const { target, status } = redirectTarget(redirect);
    return Astro.redirect(target, status);
  }
  page = await payload.pages().getBySlug(slug);
  if (!page) is404 = true;
} else {
  is404 = true;
}

if (is404 || !page) {
  Astro.response.status = 404;
}

const metaImage =
  page?.meta?.image && typeof page.meta.image === 'object' && page.meta.image.url
    ? payload.resolveMediaUrl(page.meta.image.url)
    : undefined;
---

{
  is404 || !page ? (
    <NotFoundView locale={locale} />
  ) : (
    <PageLayout
      title={page.meta?.title || page.title}
      description={page.meta?.description || page.title}
      image={metaImage}
    >
      {page.hero && <RenderHero hero={page.hero} locale={locale} />}
      <BlockRenderer layout={page.layout} locale={locale} />
    </PageLayout>
  )
}

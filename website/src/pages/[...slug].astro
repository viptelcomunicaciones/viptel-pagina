---
import PageLayout from '@/layouts/PageLayout.astro';
import BlockRenderer from '@/components/blocks/BlockRenderer.astro';
import RenderHero from '@/components/heros/RenderHero.astro';
import NotFoundView from '@/components/pages/views/NotFoundView.astro';
import { payload } from '@/lib/payload-client';
import { defaultLocale } from '@/i18n';
import { resolveCatchallRoute, applyCatchallResponseHeaders } from '@/lib/catchall';

export const prerender = false;

const { slug } = Astro.params;
const locale = defaultLocale;

// /home es la fuente de datos de la landing — nunca una página pública.
if (slug === 'home') return Astro.redirect('/', 301);

const result = await resolveCatchallRoute(`/${slug ?? ''}`, slug ?? '', locale);

if (result.redirect) {
  return Astro.redirect(result.redirect.target, result.redirect.status);
}

applyCatchallResponseHeaders(Astro.response, {
  isError: result.isError,
  hasPage: Boolean(result.page),
});

const page = result.page;

const metaImage =
  page?.meta?.image && typeof page.meta.image === 'object' && page.meta.image.url
    ? payload.resolveMediaUrl(page.meta.image.url)
    : undefined;
---

{
  result.isError || !page ? (
    <NotFoundView locale={locale} />
  ) : (
    <PageLayout
      title={page.meta?.title || page.title}
      description={page.meta?.description || page.title}
      image={metaImage}
    >
      {page.hero && <RenderHero hero={page.hero} locale={locale} />}
      <BlockRenderer layout={page.layout} locale={locale} />
    </PageLayout>
  )
}

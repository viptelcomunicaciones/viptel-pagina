---
/**
 * LandingLayout
 * Layout wrapper for landing-style pages (marketing, demo, showcase)
 * Uses Header + Footer with landing-specific configuration
 *
 * This layout is part of the "demo" layer - it can be optionally installed
 * via CLI for users who want the full landing page experience.
 */
import BaseLayout from './BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
  nofollow?: boolean;
  canonicalUrl?: string;
  includeOrgSchema?: boolean;
  includePersonSchema?: boolean;
  includeProfessionalServiceSchema?: boolean;
  headerStyle?: 'bar' | 'floating' | 'transparent' | null;
  floatingVariant?: 'transparent' | 'default' | 'solid' | null;
  headerColorScheme?: 'default' | 'invert';
  hasDarkHero?: boolean;
  showScrollProgress?: boolean;
  scrollProgressPosition?: 'top' | 'bottom';
  autoHide?: boolean;
  invertOnReturn?: boolean;
}

const {
  title,
  description,
  image,
  imageAlt,
  noindex = false,
  nofollow = false,
  canonicalUrl,
  includeOrgSchema = false,
  includePersonSchema = false,
  includeProfessionalServiceSchema = false,
  headerStyle,
  floatingVariant,
  headerColorScheme,
  hasDarkHero = false,
  showScrollProgress,
  scrollProgressPosition,
  autoHide,
  invertOnReturn,
} = Astro.props;

const isFloatingHeader = headerStyle === 'floating';
const isTransparentHeader = headerStyle === 'transparent';
const effectiveColorScheme =
  headerColorScheme ?? (isTransparentHeader && hasDarkHero ? 'invert' : 'default');
---

<BaseLayout
  title={title}
  description={description}
  image={image}
  imageAlt={imageAlt}
  noindex={noindex}
  nofollow={nofollow}
  canonicalUrl={canonicalUrl}
  includeOrgSchema={includeOrgSchema}
  includePersonSchema={includePersonSchema}
  includeProfessionalServiceSchema={includeProfessionalServiceSchema}
>
  <Header
    slot="header"
    shape={isFloatingHeader ? 'floating' : 'bar'}
    floatingVariant={isFloatingHeader ? (floatingVariant ?? undefined) : undefined}
    variant={isTransparentHeader ? 'transparent' : 'default'}
    colorScheme={isTransparentHeader ? effectiveColorScheme : headerColorScheme}
    showScrollProgress={showScrollProgress}
    scrollProgressPosition={scrollProgressPosition}
    autoHide={autoHide}
    invertOnReturn={invertOnReturn}
  />

  <div class={isFloatingHeader || isTransparentHeader ? 'min-h-screen' : 'min-h-screen pt-16'}>
    <slot />
  </div>

  <Footer slot="footer" />
</BaseLayout>

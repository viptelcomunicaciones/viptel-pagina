---
/**
 * BlogListLayout — layout compartido para las páginas de listado del blog.
 *
 * Renderiza el Hero (slot `hero`), una sección de dos columnas con el
 * `BlogSidebar` a la izquierda y el contenido en el slot por defecto,
 * y una zona `footer` (CTA / LetterGlitch) a ancho completo.
 *
 * En móvil el sidebar queda colapsado por defecto y se abre con un toggle
 * (checkbox + label, sin JS). La interacción es 100% HTML nativa.
 */
import PageLayout from '@/layouts/PageLayout.astro';
import BlogSidebar from '@/components/blog/BlogSidebar.astro';
import BlogFilterRow, { type BlogFilterItem } from '@/components/blog/BlogFilterRow.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import { t, defaultLocale } from '@/i18n';
import {
  getBlogSidebarData,
  getCategoryArchiveUrl,
  getPostTypeUrl,
  getSubcategoryArchiveUrl,
} from '@/lib/blog';

interface Props {
  locale?: string;
  title: string;
  description: string;
  activeTypeSlug?: string;
  activeCategorySlug?: string;
  activeSubcategorySlug?: string;
  activeTag?: string;
  showScrollProgress?: boolean;
  eagerReveal?: boolean;
  footerBackground?: 'default' | 'secondary' | 'invert';
}

const {
  locale = defaultLocale,
  title,
  description,
  activeTypeSlug,
  activeCategorySlug,
  activeSubcategorySlug,
  activeTag,
  showScrollProgress = false,
  eagerReveal = false,
  footerBackground = 'default',
} = Astro.props;

const sidebarData = await getBlogSidebarData(locale);

// Fila de navegación jerárquica:
//  índice → chips de tipos; tipo → chips de categorías; categoría → chips de
//  subcategorías (también en subcategoría, para saltar entre hermanas).
let filterItems: BlogFilterItem[] = [];
let filterActiveHref: string | undefined;
let filterLabel = '';

if (activeCategorySlug && activeTypeSlug) {
  const category = sidebarData.types
    .find((t) => t.type.slug === activeTypeSlug)
    ?.categories.find((c) => c.category.slug === activeCategorySlug);
  if (category && category.subcategories.length > 0) {
    filterItems = category.subcategories.map((sub) => ({
      label: sub.category.title,
      href: getSubcategoryArchiveUrl(activeTypeSlug, category.category.slug, sub.category, locale),
      count: sub.count,
    }));
    filterLabel = t('blog.filterSubcategories', locale);
    if (activeSubcategorySlug) {
      const activeSub = category.subcategories.find(
        (s) => s.category.slug === activeSubcategorySlug
      );
      if (activeSub) {
        filterActiveHref = getSubcategoryArchiveUrl(
          activeTypeSlug,
          category.category.slug,
          activeSub.category,
          locale
        );
      }
    }
  }
} else if (activeTypeSlug) {
  const type = sidebarData.types.find((t) => t.type.slug === activeTypeSlug);
  if (type && type.categories.length > 0) {
    filterItems = type.categories.map((c) => ({
      label: c.category.title,
      href: getCategoryArchiveUrl(activeTypeSlug, c.category, locale),
      count: c.count,
    }));
    filterLabel = t('blog.filterCategories', locale);
  }
} else if (!activeTag) {
  filterItems = sidebarData.types.map((t) => ({
    label: t.type.title,
    href: getPostTypeUrl(t.type.slug, locale),
    icon: t.type.icon || undefined,
    count: t.count,
  }));
  filterLabel = t('blog.filterTypes', locale);
}
---

<PageLayout
  title={title}
  description={description}
  showScrollProgress={showScrollProgress}
  eagerReveal={eagerReveal}
  footerBackground={footerBackground}
>
  <slot name="hero" />

  <section class="bg-background-secondary border-border border-t py-[var(--space-section-md)]">
    <div class="mx-auto max-w-7xl px-6">
      <div class="grid gap-8 lg:grid-cols-[16rem_minmax(0,1fr)] lg:items-start">
        <input type="checkbox" id="blog-sidebar-toggle" class="peer sr-only" />

        <label
          for="blog-sidebar-toggle"
          class="border-brand-500/40 bg-background text-brand-700 dark:text-brand-400 hover:border-brand-500/80 inline-flex w-fit cursor-pointer items-center gap-2 rounded-lg border px-4 py-2 text-sm font-medium transition-colors lg:hidden"
        >
          <Icon name="menu" size="sm" />
          {t('blog.sidebarToggle', locale)}
        </label>

        <div class="hidden peer-checked:block lg:block">
          <BlogSidebar
            locale={locale}
            types={sidebarData.types}
            tags={sidebarData.tags}
            activeTypeSlug={activeTypeSlug}
            activeCategorySlug={activeCategorySlug}
            activeSubcategorySlug={activeSubcategorySlug}
            activeTag={activeTag}
          />
        </div>

        <div class="flex min-w-0 flex-col gap-8">
          {
            filterItems.length > 0 && (
              <BlogFilterRow
                label={filterLabel}
                items={filterItems}
                activeHref={filterActiveHref}
              />
            )
          }
          <slot />
        </div>
      </div>
    </div>
  </section>

  <slot name="footer" />
</PageLayout>

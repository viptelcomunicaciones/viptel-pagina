---
/**
 * PageLayout
 * Layout wrapper for standard content pages (non-landing)
 * Uses Header + Footer with content page configuration
 */
import BaseLayout from './BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import type { Thing, WithContext } from 'schema-dts';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  article?: {
    publishedTime?: Date;
    modifiedTime?: Date;
    authors?: string[];
    tags?: string[];
  };
  extraSchemas?: WithContext<Thing>[];
  noindex?: boolean;
  nofollow?: boolean;
  showScrollProgress?: boolean;
  eagerReveal?: boolean;
  headerStyle?: 'bar' | 'floating' | 'transparent' | null;
  /**
   * Footer background. Set this to the opposite of the page's last section so
   * the zebra pattern (bg-background ↔ bg-background-secondary) stays intact:
   * - last section `bg-background`           → footer `secondary`
   * - last section `bg-background-secondary` → footer `default`
   */
  footerBackground?: 'default' | 'secondary' | 'invert';
}

const {
  title,
  description,
  image,
  imageAlt,
  article,
  extraSchemas,
  noindex,
  nofollow,
  showScrollProgress = false,
  eagerReveal = false,
  headerStyle = 'bar',
  footerBackground = 'default',
} = Astro.props;

const isFloatingHeader = headerStyle === 'floating';
const isTransparentHeader = headerStyle === 'transparent';
---

<BaseLayout
  title={title}
  description={description}
  image={image}
  imageAlt={imageAlt}
  article={article}
  extraSchemas={extraSchemas}
  noindex={noindex}
  nofollow={nofollow}
  eagerReveal={eagerReveal}
>
  {
    isFloatingHeader ? (
      <Header
        slot="header"
        position="fixed"
        shape="floating"
        variant="transparent"
        colorScheme="default"
        size="lg"
        showThemeSelector
        autoHide={false}
        scrollProgressPosition="top"
        invertOnReturn={false}
      />
    ) : isTransparentHeader ? (
      <Header
        slot="header"
        position="fixed"
        shape="bar"
        variant="transparent"
        colorScheme="invert"
        size="lg"
        showActiveState
        showScrollProgress={showScrollProgress}
      />
    ) : (
      <Header
        slot="header"
        position="fixed"
        shape="bar"
        variant="solid"
        size="lg"
        showActiveState
        showScrollProgress={showScrollProgress}
      />
    )
  }

  <main class={isFloatingHeader ? 'min-h-screen' : 'min-h-screen pt-16'}>
    <slot />
  </main>

  <Footer slot="footer" layout="centered" background={footerBackground} />
</BaseLayout>

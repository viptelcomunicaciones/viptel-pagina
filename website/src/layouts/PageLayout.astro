---
/**
 * PageLayout
 * Layout wrapper for standard content pages (non-landing)
 * Uses Header + Footer with content page configuration
 */
import BaseLayout from './BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import type { Thing, WithContext } from 'schema-dts';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  article?: {
    publishedTime?: Date;
    modifiedTime?: Date;
    authors?: string[];
    tags?: string[];
  };
  extraSchemas?: WithContext<Thing>[];
  noindex?: boolean;
  nofollow?: boolean;
  canonicalUrl?: string;
  showScrollProgress?: boolean;
  eagerReveal?: boolean;
  headerStyle?: 'bar' | 'floating' | 'transparent' | null;
  floatingVariant?: 'transparent' | 'default' | 'solid' | null;
  headerColorScheme?: 'default' | 'invert';
  hasDarkHero?: boolean;
  /**
   * Footer background override. When omitted, the global CMS Footer background is used.
   */
  footerBackground?: 'default' | 'secondary' | 'invert';
}

const {
  title,
  description,
  image,
  imageAlt,
  article,
  extraSchemas,
  noindex,
  nofollow,
  canonicalUrl,
  showScrollProgress = false,
  eagerReveal = false,
  headerStyle = 'bar',
  floatingVariant,
  headerColorScheme,
  hasDarkHero = false,
  footerBackground,
} = Astro.props;

const isFloatingHeader = headerStyle === 'floating';
const isTransparentHeader = headerStyle === 'transparent';
const effectiveColorScheme =
  headerColorScheme ?? (isTransparentHeader && hasDarkHero ? 'invert' : 'default');
---

<BaseLayout
  title={title}
  description={description}
  image={image}
  imageAlt={imageAlt}
  article={article}
  extraSchemas={extraSchemas}
  noindex={noindex}
  nofollow={nofollow}
  canonicalUrl={canonicalUrl}
  eagerReveal={eagerReveal}
>
  {
    isFloatingHeader ? (
      <Header
        slot="header"
        position="fixed"
        shape="floating"
        variant={floatingVariant ?? 'transparent'}
        colorScheme="default"
        size="lg"
        showThemeSelector
        autoHide={false}
        scrollProgressPosition="top"
        invertOnReturn={false}
      />
    ) : isTransparentHeader ? (
      <Header
        slot="header"
        position="fixed"
        shape="bar"
        variant="transparent"
        colorScheme={effectiveColorScheme}
        size="lg"
        showActiveState
        showScrollProgress={showScrollProgress}
      />
    ) : (
      <Header
        slot="header"
        position="fixed"
        shape="bar"
        variant="solid"
        size="lg"
        showActiveState
        showScrollProgress={showScrollProgress}
      />
    )
  }

  <main class={isFloatingHeader || isTransparentHeader ? 'min-h-screen' : 'min-h-screen pt-16'}>
    <slot />
  </main>

  <Footer slot="footer" background={footerBackground} />
</BaseLayout>

---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { formatDate, getReadingTime } from '@/lib/utils';
import { t, getLocaleFromPath } from '@/i18n';
import Logo from '@/components/ui/marketing/Logo/Logo.astro';
import BlogImageSVG from '@/components/blog/BlogImageSVG.astro';
import TagList from '@/components/blog/TagList.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import HeroGrid from '@/components/effects/HeroGrid.astro';
import HeroBeam from '@/components/effects/HeroBeam.astro';

interface Props {
  title: string;
  description: string;
  publishedAt: Date;
  updatedAt?: Date;
  /** Author name. When omitted (no author assigned in the CMS), the byline is hidden. */
  author?: string;
  tags?: string[];
  image?: ImageMetadata;
  imageAlt?: string;
  /** Pre-resolved image URL (CMS-hosted media) — rendered as a plain <img>. */
  imageUrl?: string;
  svgSlug?: string;
  /** Raw post body, used to estimate reading time (CJK-aware). */
  body?: string;
  /** Tipo de contenido del post (badge enlazado al archivo de tipo). */
  postTypeName?: string;
  /** Icono Lucide del tipo de post. */
  postTypeIcon?: string;
  /** URL del archivo de tipo. */
  postTypeHref?: string;
  /** Categoría del post (badge enlazado al archivo de categoría). */
  postCategoryName?: string;
  /** URL del archivo de categoría. */
  postCategoryHref?: string;
}

const {
  title,
  description,
  publishedAt,
  updatedAt,
  author,
  tags = [],
  image,
  imageAlt,
  imageUrl,
  svgSlug,
  body,
  postTypeName,
  postTypeIcon,
  postTypeHref,
  postCategoryName,
  postCategoryHref,
} = Astro.props;

const locale = getLocaleFromPath(Astro.url.pathname);

// Reading time from the actual post body (falls back to the description if no
// body is passed). Counts CJK characters, so space-less languages such as
// Chinese, Japanese, and Korean aren't all estimated as "1 min".
const readingTime = getReadingTime(body ?? description);
---

<header
  class="article-hero relative isolate overflow-hidden pt-[var(--space-page-top-sm)] pb-[var(--space-section)]"
>
  <HeroGrid />
  <HeroBeam />

  <div class="animate-hero-stagger relative z-[1] mx-auto max-w-4xl px-6">
    <!-- Post type + category pills -->
    {
      (postTypeName || postCategoryName) && (
        <div class="mb-4 flex flex-wrap items-center gap-2">
          {postTypeName &&
            (postTypeHref ? (
              <a
                href={postTypeHref}
                class="bg-brand-500/10 text-brand-700 dark:text-brand-400 ring-brand-500/40 hover:bg-brand-500/20 inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-xs font-semibold ring-1 transition-colors ring-inset"
              >
                <Icon name={postTypeIcon || 'file-text'} size="xs" />
                {postTypeName}
              </a>
            ) : (
              <span class="bg-brand-500/10 text-brand-700 dark:text-brand-400 ring-brand-500/40 inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-xs font-semibold ring-1 ring-inset">
                <Icon name={postTypeIcon || 'file-text'} size="xs" />
                {postTypeName}
              </span>
            ))}
          {postCategoryName &&
            (postCategoryHref ? (
              <a
                href={postCategoryHref}
                class="bg-background/60 text-foreground-muted ring-border/60 hover:ring-brand-500/80 inline-flex items-center rounded-full px-3 py-1 text-xs font-medium ring-1 transition-colors ring-inset"
              >
                {postCategoryName}
              </a>
            ) : (
              <span class="bg-background/60 text-foreground-muted ring-border/60 inline-flex items-center rounded-full px-3 py-1 text-xs font-medium ring-1 ring-inset">
                {postCategoryName}
              </span>
            ))}
        </div>
      )
    }
    <!-- Title -->
    <h1
      class="font-display text-foreground mb-[var(--space-heading-gap)] text-4xl font-bold tracking-tight md:text-5xl lg:text-6xl"
    >
      {title}
    </h1>

    <!-- Description -->
    <p class="text-foreground-muted mb-[var(--space-stack-lg)] max-w-3xl text-xl leading-relaxed">
      {description}
    </p>

    <!-- Tags (directly below the abstract, where the issue marked them) -->
    {tags.length > 0 && <TagList tags={tags} locale={locale} class="mb-[var(--space-stack-lg)]" />}

    <!-- Meta info -->
    <div
      class="text-foreground-muted flex flex-wrap items-center gap-[var(--space-stack-lg)] text-sm"
    >
      <!-- Author -->
      {
        author && (
          <>
            <div class="flex items-center gap-3">
              <Logo size="sm" letter={author.charAt(0).toUpperCase()} />
              <p class="text-foreground font-semibold">{author}</p>
            </div>

            <div class="bg-border hidden h-8 w-px md:block" />
          </>
        )
      }

      <!-- Published date -->
      <div class="flex items-center gap-2">
        <svg
          class="text-foreground-subtle h-5 w-5"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="1.5"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5"
          ></path>
        </svg>
        <time datetime={publishedAt.toISOString()}>
          {formatDate(publishedAt, locale)}
        </time>
      </div>

      {
        updatedAt && (
          <>
            <div class="bg-border hidden h-8 w-px md:block" />
            <div class="flex items-center gap-2">
              <svg
                class="text-foreground-subtle h-5 w-5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="1.5"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99"
                />
              </svg>
              <time datetime={updatedAt.toISOString()}>
                {t('blog.updated', locale)} {formatDate(updatedAt, locale)}
              </time>
            </div>
          </>
        )
      }

      <div class="bg-border hidden h-8 w-px md:block"></div>

      <!-- Reading time -->
      <div class="flex items-center gap-2">
        <svg
          class="text-foreground-subtle h-5 w-5"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="1.5"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        <span>{t('blog.readingTime', locale, { minutes: readingTime })}</span>
      </div>
    </div>
  </div>

  {
    (svgSlug || image || imageUrl) && (
      <div class="animate-hero-slide-up relative z-[1] mx-auto mt-[var(--space-section)] max-w-5xl px-6 [animation-delay:450ms]">
        {svgSlug ? (
          <div
            class="media-shadow relative overflow-hidden rounded-xl"
            style="color: var(--brand-500);"
          >
            <BlogImageSVG slug={svgSlug} title={imageAlt || title} />
          </div>
        ) : image ? (
          <div class="media-shadow relative overflow-hidden rounded-xl">
            <Image
              src={image}
              alt={imageAlt || title}
              layout="full-width"
              widths={[640, 960, 1280, 1920]}
              sizes="100vw"
              class="aspect-video w-full object-cover"
              loading="eager"
            />
          </div>
        ) : imageUrl ? (
          <div class="media-shadow relative overflow-hidden rounded-xl">
            <img
              src={imageUrl}
              alt={imageAlt || title}
              loading="eager"
              class="aspect-video w-full object-cover"
            />
          </div>
        ) : null}
      </div>
    )
  }
</header>

<style>
  /* The hero grid/beam span the whole <header>, which on the blog post also
     contains the large featured image below the intro — so the pattern runs
     far too low. Cap both with a soft vertical fade measured from the header
     top so they disappear just under the intro text: under the H1 on mobile,
     under the lead paragraph on desktop. (The beam's top light sits above
     this fade, so only the grid is trimmed.) */
  .article-hero :global(.hero-grid),
  .article-hero :global(.hero-beam) {
    --grid-fade-start: 200px;
    --grid-fade-end: 320px;
    -webkit-mask-image: linear-gradient(
      to bottom,
      #000 0,
      #000 var(--grid-fade-start),
      transparent var(--grid-fade-end)
    );
    mask-image: linear-gradient(
      to bottom,
      #000 0,
      #000 var(--grid-fade-start),
      transparent var(--grid-fade-end)
    );
  }

  @media (min-width: 1024px) {
    .article-hero :global(.hero-grid),
    .article-hero :global(.hero-beam) {
      --grid-fade-start: 280px;
      --grid-fade-end: 430px;
    }
  }
</style>

---
import BlogCard from './BlogCard.astro';
import { t, defaultLocale } from '@/i18n';
import { getPostUrl } from '@/lib/blog';
import { payload } from '@/lib/payload-client';
import type { Post } from '@/lib/payload-types';

interface Props {
  currentSlug: string;
  tags: string[];
  locale?: string;
  maxPosts?: number;
}

const { currentSlug, tags, locale = defaultLocale, maxPosts = 3 } = Astro.props;

const allPosts = await payload.posts().getAll(locale).catch(() => [] as Post[]);

const relatedPosts = allPosts
  .filter((post) => {
    if (post.slug === currentSlug) return false;
    if (!tags.length) return false;
    return (post.tags || []).some((t) => tags.includes(t.tag ?? ""));
  })
  .sort((a, b) => {
    const aMatches = (a.tags || []).filter((t) => tags.includes(t.tag ?? "")).length;
    const bMatches = (b.tags || []).filter((t) => tags.includes(t.tag ?? "")).length;
    if (bMatches !== aMatches) return bMatches - aMatches;
    return ((b.publishedAt ? new Date(b.publishedAt) : new Date()) as Date).getTime() - ((a.publishedAt ? new Date(a.publishedAt) : new Date()) as Date).getTime();
  })
  .slice(0, maxPosts);
---

{relatedPosts.length > 0 && (
  <section class="border-t border-border py-[var(--space-section-sm)]">
    <h2 class="font-display text-2xl font-bold text-foreground mb-[var(--space-stack-lg)] text-center">
      {t('blog.relatedPosts', locale)}
    </h2>

    <div class="grid gap-[var(--space-stack-lg)] md:grid-cols-2 lg:grid-cols-3">
      {relatedPosts.map((post) => (
        <BlogCard
          title={post.title}
          description={post.excerpt || ''}
          href={getPostUrl(post, locale)}
          publishedAt={((post.publishedAt ? new Date(post.publishedAt) : new Date()) as Date)}
          tags={(post.tags || []).map((t) => t.tag)}
          author={post.populatedAuthors?.[0]?.name || 'Viptel'}
        />
      ))}
    </div>
  </section>
)}

---
/**
 * PostHero — hero section for blog posts and projects.
 * Shows cover image as background with metadata overlay.
 */
import { payload } from '@/lib/payload-client'

interface Props {
  title: string
  imageUrl?: string | null
  imageAlt?: string | null
  publishedAt?: string | null
  author?: string | null
  tags?: string[]
  locale?: string
}

const { title, imageUrl, imageAlt, publishedAt, author, tags = [], locale = 'es' } = Astro.props
---

<section class="relative overflow-hidden rounded-xl mb-10">
  {imageUrl ? (
    <>
      <div
        class="w-full min-h-[320px] bg-cover bg-center"
        style={`background-image: linear-gradient(rgba(0,0,0,0.4),rgba(0,0,0,0.6)), url(${payload.resolveMediaUrl(imageUrl)}); min-height: 320px;`}
      />
      <div class="absolute inset-0 flex flex-col justify-end p-8 md:p-12">
        <h1 class="text-2xl md:text-4xl font-bold text-white mb-4">{title}</h1>
        <div class="flex flex-wrap items-center gap-4 text-sm text-white/80">
          {publishedAt && (
            <time>
              {new Date(publishedAt).toLocaleDateString(
                locale === 'en' ? 'en-US' : 'es-CO',
                { year: 'numeric', month: 'long', day: 'numeric' },
              )}
            </time>
          )}
          {author && <span class="font-medium">{author}</span>}
        </div>
        {tags.length > 0 && (
          <div class="flex flex-wrap gap-1.5 mt-3">
            {tags.map((tag) => (
              <span class="inline-flex items-center rounded-full bg-white/20 px-2.5 py-0.5 text-xs font-medium text-white">
                #{tag}
              </span>
            ))}
          </div>
        )}
      </div>
    </>
  ) : (
    <div class="py-12">
      <h1 class="text-2xl md:text-4xl font-bold text-foreground mb-4">{title}</h1>
      <div class="flex flex-wrap items-center gap-4 text-sm text-foreground-muted">
        {publishedAt && (
          <time>
            {new Date(publishedAt).toLocaleDateString(
              locale === 'en' ? 'en-US' : 'es-CO',
              { year: 'numeric', month: 'long', day: 'numeric' },
            )}
          </time>
        )}
        {author && <span class="font-medium">{author}</span>}
      </div>
      {tags.length > 0 && (
        <div class="flex flex-wrap gap-1.5 mt-3">
          {tags.map((tag) => (
            <span class="inline-flex items-center rounded-full bg-transparent px-2.5 py-0.5 text-xs font-medium text-brand-700 dark:text-brand-400 ring-1 ring-inset ring-brand-500/40">
              #{tag}
            </span>
          ))}
        </div>
      )}
    </div>
  )}
</section>

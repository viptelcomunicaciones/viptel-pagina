---
/**
 * Pure-HTML pagination control. No client-side JS.
 *
 * Renders prev/next arrows plus a sliding window of up to 5 page links
 * around the current page. Designed to be reused across the blog index
 * and tag archive pages.
 */
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import { t, getLocaleFromPath } from '@/i18n';

interface Props {
  currentPage: number;
  totalPages: number;
  href: (page: number) => string;
  totalDocs?: number;
  pageSize?: number;
}

const { currentPage, totalPages, href, totalDocs, pageSize = 12 } = Astro.props;
const locale = getLocaleFromPath(Astro.url.pathname);

const startItem = (currentPage - 1) * pageSize + 1;
const endItem = Math.min(currentPage * pageSize, totalDocs ?? Infinity);

if (totalPages <= 1) {
  // Render nothing — pagination has no purpose with one page.
}

// Build a small window of pages to show, capped at 5 entries, always
// including page 1 and the last page when possible.
function buildWindow(current: number, total: number, max = 5): number[] {
  if (total <= max) {
    return Array.from({ length: total }, (_, i) => i + 1);
  }
  const half = Math.floor(max / 2);
  let start = Math.max(1, current - half);
  const end = Math.min(total, start + max - 1);
  start = Math.max(1, end - max + 1);
  return Array.from({ length: end - start + 1 }, (_, i) => start + i);
}

const pages = buildWindow(currentPage, totalPages);
const prevHref = currentPage > 1 ? href(currentPage - 1) : null;
const nextHref = currentPage < totalPages ? href(currentPage + 1) : null;
---

{
  totalPages > 1 && (
    <div class="mt-12 flex flex-col items-center gap-4">
      {totalDocs !== undefined && (
        <p class="text-foreground-muted text-sm">
          {t('pagination.showing', locale, {
            start: String(startItem),
            end: String(endItem),
            total: String(totalDocs),
          })}
        </p>
      )}
      <nav
        class="flex items-center justify-center gap-2"
        aria-label={t('pagination.label', locale)}
      >
        {prevHref ? (
          <a
            href={prevHref}
            class="border-border bg-background text-foreground-muted hover:border-brand-500 hover:text-brand-500 inline-flex h-10 w-10 items-center justify-center rounded-full border transition-colors"
            aria-label={t('pagination.previousPage', locale)}
            rel="prev"
          >
            <Icon name="arrow-left" size="sm" />
          </a>
        ) : (
          <span
            class="border-border bg-background text-foreground-muted pointer-events-none inline-flex h-10 w-10 cursor-not-allowed items-center justify-center rounded-full border opacity-40"
            aria-disabled="true"
            aria-label={t('pagination.previousPage', locale)}
          >
            <Icon name="arrow-left" size="sm" />
          </span>
        )}

        <ol class="flex items-center gap-1">
          {pages[0] > 1 && (
            <>
              <li>
                <a
                  href={href(1)}
                  class="border-border bg-background text-foreground hover:border-brand-500 hover:text-brand-500 inline-flex h-10 min-w-10 items-center justify-center rounded-full border px-3 text-sm font-medium transition-colors"
                >
                  1
                </a>
              </li>
              {pages[0] > 2 && (
                <li aria-hidden="true" class="text-foreground-subtle px-1 text-sm">
                  …
                </li>
              )}
            </>
          )}

          {pages.map((page) => (
            <li>
              <a
                href={href(page)}
                class:list={[
                  'inline-flex h-10 min-w-10 items-center justify-center rounded-full border px-3 text-sm font-medium transition-colors',
                  page === currentPage
                    ? 'border-brand-500 bg-brand-500 pointer-events-none text-white'
                    : 'border-border bg-background text-foreground hover:border-brand-500 hover:text-brand-500',
                ]}
                aria-current={page === currentPage ? 'page' : undefined}
              >
                {page}
              </a>
            </li>
          ))}

          {pages[pages.length - 1] < totalPages && (
            <>
              {pages[pages.length - 1] < totalPages - 1 && (
                <li aria-hidden="true" class="text-foreground-subtle px-1 text-sm">
                  …
                </li>
              )}
              <li>
                <a
                  href={href(totalPages)}
                  class="border-border bg-background text-foreground hover:border-brand-500 hover:text-brand-500 inline-flex h-10 min-w-10 items-center justify-center rounded-full border px-3 text-sm font-medium transition-colors"
                >
                  {totalPages}
                </a>
              </li>
            </>
          )}
        </ol>

        {nextHref ? (
          <a
            href={nextHref}
            class="border-border bg-background text-foreground-muted hover:border-brand-500 hover:text-brand-500 inline-flex h-10 w-10 items-center justify-center rounded-full border transition-colors"
            aria-label={t('pagination.nextPage', locale)}
            rel="next"
          >
            <Icon name="arrow-right" size="sm" />
          </a>
        ) : (
          <span
            class="border-border bg-background text-foreground-muted pointer-events-none inline-flex h-10 w-10 cursor-not-allowed items-center justify-center rounded-full border opacity-40"
            aria-disabled="true"
            aria-label={t('pagination.nextPage', locale)}
          >
            <Icon name="arrow-right" size="sm" />
          </span>
        )}
      </nav>
    </div>
  )
}

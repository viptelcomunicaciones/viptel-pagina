---
/**
 * BlogFilterRow — fila de navegación jerárquica de los listados del blog.
 *
 * Pills horizontales (icono + nombre + conteo) que se usan en el índice
 * (tipos), en la página de tipo (categorías) y en la página de categoría
 * (subcategorías).
 *
 * Sin JS: son enlaces normales. El elemento activo recibe `aria-current="page"`.
 */
import Icon from '@/components/ui/primitives/Icon/Icon.astro';

export interface BlogFilterItem {
  label: string;
  href: string;
  icon?: string;
  count?: number;
}

interface Props {
  /** Descripción accesible de la fila. */
  label: string;
  items: BlogFilterItem[];
  /** Href del elemento actual (marca `aria-current`). */
  activeHref?: string;
}

const { label, items, activeHref } = Astro.props;
---

{
  items.length > 0 && (
    <div class="flex flex-wrap items-center gap-2" role="list" aria-label={label}>
      {items.map((item) => (
        <a
          role="listitem"
          href={item.href}
          aria-current={activeHref === item.href ? 'page' : undefined}
          class={
            activeHref === item.href
              ? 'border-brand-500 bg-brand-500 inline-flex items-center gap-1.5 rounded-full border px-3.5 py-1.5 text-sm font-medium text-white'
              : 'border-border bg-background text-foreground hover:border-brand-500/60 hover:text-brand-600 dark:hover:text-brand-400 inline-flex items-center gap-1.5 rounded-full border px-3.5 py-1.5 text-sm font-medium transition-colors'
          }
        >
          {item.icon && <Icon name={item.icon} size="sm" />}
          {item.label}
          {item.count !== undefined && (
            <span class="text-foreground-muted text-xs">{item.count}</span>
          )}
        </a>
      ))}
    </div>
  )
}

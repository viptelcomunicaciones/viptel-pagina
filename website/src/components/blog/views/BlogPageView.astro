---
/**
 * BlogPageView — a paginated blog index page (page 2..N).
 *
 * Shared body for the default-locale route (`/blog/page/N`) and the
 * locale-prefixed route (`/<locale>/blog/page/N`). Renders inside
 * `BlogListLayout`, which provides the left sidebar navigation.
 */
import BlogListLayout from '@/layouts/BlogListLayout.astro';
import BlogCard from '@/components/blog/BlogCard.astro';
import Pagination from '@/components/blog/Pagination.astro';
import Badge from '@/components/ui/data-display/Badge/Badge.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import CTA from '@/components/ui/marketing/CTA/CTA.astro';
import LetterGlitchBand from '@/components/patterns/LetterGlitchBand.astro';
import NewsletterForm from '@/components/patterns/NewsletterForm.astro';
import { Hero } from '@/components/hero';
import siteConfig from '@/config/site.config';
import { resolveSocialLinks } from '@/lib/utils';
import { t, defaultLocale } from '@/i18n';
import { payload } from '@/lib/payload-client';
import {
  BLOG_POSTS_PER_PAGE,
  getBlogBaseUrl,
  getBlogPageUrl,
  getPostUrl,
  getTagName,
  getPostTypeIcon,
  getPostTypeName,
} from '@/lib/blog';

interface Props {
  /** Locale whose posts this page renders. Defaults to the site default. */
  locale?: string;
  /** 1-based page number (always >= 2 for this view). */
  page: number;
}

const { locale = defaultLocale, page } = Astro.props;

const { docs, totalDocs, totalPages } = await payload
  .posts()
  .getPaginated(locale, page, BLOG_POSTS_PER_PAGE);

const pagePosts = docs;

const socialLinks = resolveSocialLinks(siteConfig.socialLinks);
---

<BlogListLayout
  title={t('blog.pageMetaTitle', locale, { page })}
  description={t('blog.pageMetaDescription', locale, { page, total: totalPages })}
  locale={locale}
  showScrollProgress
  eagerReveal
  footerBackground="secondary"
  activeTypeSlug=""
>
  <Fragment slot="hero">
    <Hero layout="centered" size="sm">
      <Badge slot="badge" variant="brand" pill>
        <Icon name="book" size="sm" />
        {t('blog.pageBadge', locale, { page, total: totalPages })}
      </Badge>

      <h1 slot="title">{t('blog.title', locale)}</h1>

      <p slot="description" class="!text-balance">{t('blog.heroDescription', locale)}</p>
    </Hero>
  </Fragment>

  <a
    href={getBlogBaseUrl(locale)}
    class="group border-brand-500/40 text-brand-700 dark:text-brand-400 hover:border-brand-500/80 hover:bg-brand-500/10 inline-flex w-fit items-center gap-2 rounded-lg border bg-transparent px-4 py-2 text-sm font-medium transition-colors"
  >
    <Icon name="arrow-left" size="sm" />
    {t('blog.newestPosts', locale)}
  </a>

  <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
    {
      pagePosts.map((post, index) => (
        <BlogCard
          title={post.title}
          description={post.excerpt || ''}
          href={getPostUrl(post, locale)}
          publishedAt={new Date(post.publishedAt ?? '')}
          tags={(post.tags ?? []).map((t) => getTagName(t))}
          author={post.populatedAuthors?.[0]?.name || 'Viptel'}
          imageUrl={
            post.heroImage && typeof post.heroImage !== 'number'
              ? payload.resolveMediaUrl(post.heroImage.url ?? '')
              : undefined
          }
          postTypeName={getPostTypeName(post)}
          postTypeIcon={getPostTypeIcon(post)}
          revealDelay={index % 3}
          eager={index < 3}
        />
      ))
    }
  </div>

  <Pagination
    currentPage={page}
    totalPages={totalPages}
    href={(p) => getBlogPageUrl(p, locale)}
    totalDocs={totalDocs}
    pageSize={BLOG_POSTS_PER_PAGE}
  />

  <Fragment slot="footer">
    <CTA variant="default" size="md" maxWidth="lg" glow={false} data-reveal class="glitch:hidden">
      <h2 slot="heading" class="!text-4xl">{t('blog.followAlong', locale)}</h2>
      <p slot="description" class="!text-lg text-balance">{t('blog.followAlongLead', locale)}</p>

      <div class="flex flex-wrap items-center justify-center gap-3">
        <a
          href="/rss.xml"
          class="border-brand-500/40 bg-background text-brand-700 dark:text-brand-400 hover:border-brand-500/80 inline-flex items-center gap-2 rounded-full border px-4 py-2 text-sm font-medium transition-colors"
        >
          <Icon name="rss" size="sm" />
          {t('blog.rssFeed', locale)}
        </a>
        {
          socialLinks.map((link) => (
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              class="border-brand-500/40 bg-background text-brand-700 dark:text-brand-400 hover:border-brand-500/80 inline-flex items-center gap-2 rounded-full border px-4 py-2 text-sm font-medium transition-colors"
            >
              <Icon name={link.icon} size="sm" />
              {link.label}
            </a>
          ))
        }
        <a
          href={`mailto:${siteConfig.email}`}
          class="border-brand-500/40 bg-background text-brand-700 dark:text-brand-400 hover:border-brand-500/80 inline-flex items-center gap-2 rounded-full border px-4 py-2 text-sm font-medium transition-colors"
        >
          <Icon name="mail" size="sm" />
          {t('blog.emailLabel', locale)}
        </a>
      </div>

      <div class="mx-auto mt-8 w-full max-w-md">
        <p class="text-foreground-muted mb-3 text-sm">{t('newsletter.description', locale)}</p>
        <NewsletterForm />
      </div>
    </CTA>

    <section class="glitch:block bg-background relative z-10 hidden py-[var(--space-section-md)]">
      <LetterGlitchBand>
        <h2 class="font-display text-foreground mb-4 text-4xl font-bold text-balance">
          {t('blog.followAlong', locale)}
        </h2>
        <p class="text-foreground-muted mb-8 text-lg text-balance">
          {t('blog.followAlongLead', locale)}
        </p>

        <div class="flex flex-wrap items-center justify-center gap-3">
          <a
            href="/rss.xml"
            class="text-foreground hover:border-brand-400 hover:bg-brand-500/20 hover:text-foreground inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/5 px-4 py-2 text-sm font-medium transition-colors"
          >
            <Icon name="rss" size="sm" />
            {t('blog.rssFeed', locale)}
          </a>
          {
            socialLinks.map((link) => (
              <a
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
                class="text-foreground hover:border-brand-400 hover:bg-brand-500/20 hover:text-foreground inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/5 px-4 py-2 text-sm font-medium transition-colors"
              >
                <Icon name={link.icon} size="sm" />
                {link.label}
              </a>
            ))
          }
          <a
            href={`mailto:${siteConfig.email}`}
            class="text-foreground hover:border-brand-400 hover:bg-brand-500/20 hover:text-foreground inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/5 px-4 py-2 text-sm font-medium transition-colors"
          >
            <Icon name="mail" size="sm" />
            {t('blog.emailLabel', locale)}
          </a>
        </div>
      </LetterGlitchBand>
    </section>
  </Fragment>
</BlogListLayout>

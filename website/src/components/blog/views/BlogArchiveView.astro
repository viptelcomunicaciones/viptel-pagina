---
/**
 * BlogArchiveView — archivo jerárquico del blog: tipo, categoría o
 * subcategoría.
 *
 * Comparte cuerpo para la ruta con idioma (`/<locale>/blog/...`) y la ruta por
 * defecto (`/blog/...`). Recibe el resultado del resolver (`resolveBlogArchive`)
 * y construye URLs con awareness de idioma vía `lib/blog`.
 */
import PageLayout from '@/layouts/PageLayout.astro';
import BlogCard from '@/components/blog/BlogCard.astro';
import BlogTypeTabs from '@/components/blog/BlogTypeTabs.astro';
import Pagination from '@/components/blog/Pagination.astro';
import TagList from '@/components/blog/TagList.astro';
import Badge from '@/components/ui/data-display/Badge/Badge.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import Button from '@/components/ui/form/Button/Button.astro';
import CTA from '@/components/ui/marketing/CTA/CTA.astro';
import LetterGlitchBand from '@/components/patterns/LetterGlitchBand.astro';
import { Hero } from '@/components/hero';
import siteConfig from '@/config/site.config';
import { resolveSocialLinks } from '@/lib/utils';
import { t, defaultLocale } from '@/i18n';
import { payload } from '@/lib/payload-client';
import {
  BLOG_POSTS_PER_PAGE,
  BLOG_TAG_CLOUD_LIMIT,
  collectTopTags,
  getBlogBaseUrl,
  getCategoryArchiveUrl,
  getPostTypeUrl,
  getPostUrl,
  getPublishedPosts,
  getSubcategoryArchiveUrl,
  getTagName,
  getPostTypeIcon,
  getPostTypeName,
} from '@/lib/blog';
import type { BlogArchive } from '@/lib/blog';
import type { Post } from '@/lib/payload-types';

interface Props {
  /** Locale cuyos posts renderiza este archivo. */
  locale?: string;
  /** Resultado del resolver del catch-all. */
  archive: BlogArchive;
  /** Página actual (paginación por query param). */
  currentPage?: number;
}

const { locale = defaultLocale, archive, currentPage = 1 } = Astro.props;

if (archive.kind === 'not-found' || archive.kind === 'post' || !archive.postType) {
  throw new Error('BlogArchiveView requires a type/category/subcategory archive')
}

const { postType, category, subcategory } = archive;
const posts = (archive.posts ?? []) as Post[];
const totalDocs = archive.totalDocs ?? 0;
const totalPages = archive.totalPages ?? 1;

const allPosts = await getPublishedPosts(locale);
const topTags = collectTopTags(allPosts, BLOG_TAG_CLOUD_LIMIT);

const heading = subcategory?.title ?? category?.title ?? postType.title;
const archiveBaseUrl = subcategory
  ? getSubcategoryArchiveUrl(postType.slug, category!.slug, subcategory, locale)
  : category
    ? getCategoryArchiveUrl(postType.slug, category, locale)
    : getPostTypeUrl(postType.slug, locale);
const socialLinks = resolveSocialLinks(siteConfig.socialLinks);
const countKey = totalDocs === 1 ? 'blog.archiveCountOne' : 'blog.archiveCountOther';
---

<PageLayout
  title={`${heading} — ${t('blog.title', locale)}`}
  description={postType.description || t('blog.metaDescription', locale)}
  eagerReveal
>
  <Hero layout="centered" size="sm">
    <Badge slot="badge" variant="brand" pill>
      <Icon name={postType.icon || 'book'} size="sm" />
      {postType.title}
    </Badge>

    <h1 slot="title" class="!text-4xl sm:!text-5xl md:!text-6xl lg:!text-7xl break-words [overflow-wrap:anywhere]">
      {heading}
    </h1>

    <p slot="description">{postType.description || t(countKey, locale, { count: totalDocs })}</p>
  </Hero>

  <section class="bg-background-secondary py-[var(--space-section-md)] border-t border-border">
    <div class="mx-auto max-w-6xl px-6 flex flex-col gap-8">
      <div class="flex flex-col items-center gap-4" data-reveal>
        <nav aria-label="Breadcrumb" class="flex flex-wrap items-center justify-center gap-1.5 text-sm text-foreground-muted">
          <a href={getBlogBaseUrl(locale)} class="font-medium text-brand-700 dark:text-brand-400 hover:underline">
            {t('blog.title', locale)}
          </a>
          <Icon name="chevron-right" size="xs" class="text-foreground-subtle" />
          <a href={getPostTypeUrl(postType.slug, locale)} class="font-medium text-brand-700 dark:text-brand-400 hover:underline">
            {postType.title}
          </a>
          {category && (
            <>
              <Icon name="chevron-right" size="xs" class="text-foreground-subtle" />
              <a href={getCategoryArchiveUrl(postType.slug, category, locale)} class="font-medium text-brand-700 dark:text-brand-400 hover:underline">
                {category.title}
              </a>
            </>
          )}
          {subcategory && (
            <>
              <Icon name="chevron-right" size="xs" class="text-foreground-subtle" />
              <span class="font-medium text-foreground" aria-current="page">{subcategory.title}</span>
            </>
          )}
        </nav>

        <BlogTypeTabs postTypes={await payload.postTypes().getAll(locale)} activeSlug={postType.slug} locale={locale} />

        {topTags.length > 0 && (
          <TagList tags={topTags} locale={locale} class="justify-center" />
        )}
      </div>

      {posts.length > 0 ? (
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {posts.map((post, index) => (
            <BlogCard
              title={post.title}
              description={post.excerpt || ''}
              href={getPostUrl(post, locale)}
              publishedAt={new Date(post.publishedAt ?? '')}
              tags={(post.tags ?? []).map(tag => getTagName(tag))}
              author={post.populatedAuthors?.[0]?.name || 'Viptel'}
              imageUrl={post.heroImage && typeof post.heroImage !== 'number' ? payload.resolveMediaUrl(post.heroImage.url ?? '') : undefined}
              postTypeName={getPostTypeName(post)}
              postTypeIcon={getPostTypeIcon(post)}
              revealDelay={index % 3}
              eager={index === 0}
            />
          ))}
        </div>
      ) : (
        <div class="py-16 text-center">
          <div class="bg-background mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full">
            <Icon name="file-text" size="lg" class="text-foreground-muted" />
          </div>
          <p class="text-foreground-muted text-lg">{t('blog.archiveEmpty', locale)}</p>
          <div class="mt-6">
            <Button href={getBlogBaseUrl(locale)} variant="brand-outline" size="sm">
              <Icon name="arrow-left" size="sm" />
              {t('blog.allPosts', locale)}
            </Button>
          </div>
        </div>
      )}

      {posts.length > 0 && totalPages > 1 && (
        <Pagination
          currentPage={currentPage}
          totalPages={totalPages}
          href={(page) => (page <= 1 ? archiveBaseUrl : `${archiveBaseUrl}?page=${page}`)}
          totalDocs={totalDocs}
          pageSize={BLOG_POSTS_PER_PAGE}
        />
      )}
    </div>
  </section>

  <CTA variant="default" size="md" maxWidth="lg" glow={false} data-reveal class="glitch:hidden">
    <h2 slot="heading" class="!text-4xl">{t('blog.followAlong', locale)}</h2>
    <p slot="description" class="!text-lg text-balance">{t('blog.followAlongLead', locale)}</p>

    <div class="flex flex-wrap items-center justify-center gap-3">
      <a
        href="/rss.xml"
        class="inline-flex items-center gap-2 rounded-full border border-brand-500/40 bg-background px-4 py-2 text-sm font-medium text-brand-700 dark:text-brand-400 transition-colors hover:border-brand-500/80"
      >
        <Icon name="rss" size="sm" />
        {t('blog.rssFeed', locale)}
      </a>
      {socialLinks.map((link) => (
        <a
          href={link.href}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-full border border-brand-500/40 bg-background px-4 py-2 text-sm font-medium text-brand-700 dark:text-brand-400 transition-colors hover:border-brand-500/80"
        >
          <Icon name={link.icon} size="sm" />
          {link.label}
        </a>
      ))}
      <a
        href={`mailto:${siteConfig.email}`}
        class="inline-flex items-center gap-2 rounded-full border border-brand-500/40 bg-background px-4 py-2 text-sm font-medium text-brand-700 dark:text-brand-400 transition-colors hover:border-brand-500/80"
      >
        <Icon name="mail" size="sm" />
        {t('blog.emailLabel', locale)}
      </a>
    </div>
  </CTA>

  <section class="hidden glitch:block relative z-10 py-[var(--space-section-md)] bg-background">
    <LetterGlitchBand>
      <h2 class="font-display text-4xl font-bold text-foreground mb-4 text-balance">{t('blog.followAlong', locale)}</h2>
      <p class="text-lg text-foreground-muted mb-8 text-balance">{t('blog.followAlongLead', locale)}</p>

      <div class="flex flex-wrap items-center justify-center gap-3">
        <a
          href="/rss.xml"
          class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/5 px-4 py-2 text-sm font-medium text-foreground transition-colors hover:border-brand-400 hover:bg-brand-500/20 hover:text-foreground"
        >
          <Icon name="rss" size="sm" />
          {t('blog.rssFeed', locale)}
        </a>
        {socialLinks.map((link) => (
          <a
            href={link.href}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/5 px-4 py-2 text-sm font-medium text-foreground transition-colors hover:border-brand-400 hover:bg-brand-500/20 hover:text-foreground"
          >
            <Icon name={link.icon} size="sm" />
            {link.label}
          </a>
        ))}
        <a
          href={`mailto:${siteConfig.email}`}
          class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/5 px-4 py-2 text-sm font-medium text-foreground transition-colors hover:border-brand-400 hover:bg-brand-500/20 hover:text-foreground"
        >
          <Icon name="mail" size="sm" />
          {t('blog.emailLabel', locale)}
        </a>
      </div>
    </LetterGlitchBand>
  </section>
</PageLayout>
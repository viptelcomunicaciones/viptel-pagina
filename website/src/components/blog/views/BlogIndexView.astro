---
/**
 * BlogIndexView — the blog landing page (page 1).
 *
 * Shared body for the default-locale route (`/blog`) and the locale-prefixed
 * route (`/<locale>/blog`). All post/pagination/tag URLs are built locale-aware
 * via the helpers in `lib/blog`, so rendering with the default locale produces
 * exactly the same markup the route did before this was extracted.
 */
import PageLayout from '@/layouts/PageLayout.astro';
import BlogCard from '@/components/blog/BlogCard.astro';
import Pagination from '@/components/blog/Pagination.astro';
import TagList from '@/components/blog/TagList.astro';
import Badge from '@/components/ui/data-display/Badge/Badge.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import CTA from '@/components/ui/marketing/CTA/CTA.astro';
import LetterGlitchBand from '@/components/patterns/LetterGlitchBand.astro';
import { Hero } from '@/components/hero';
import siteConfig from '@/config/site.config';
import { resolveSocialLinks } from '@/lib/utils';
import { t, defaultLocale } from '@/i18n';
import { payload } from '@/lib/payload-client';
import {
  BLOG_POSTS_PER_PAGE,
  BLOG_TAG_CLOUD_LIMIT,
  collectTopTags,
  getBlogPageUrl,
  getPostUrl,
  getPublishedPosts,
  getTagName,
} from '@/lib/blog';

interface Props {
  /** Locale whose posts this index renders. Defaults to the site default. */
  locale?: string;
}

const { locale = defaultLocale } = Astro.props;

const socialLinks = resolveSocialLinks(siteConfig.socialLinks);

const { docs, totalDocs, totalPages } = await payload.posts().getPaginated(locale, 1, BLOG_POSTS_PER_PAGE);

const allPosts = await getPublishedPosts(locale);
const topTags = collectTopTags(allPosts, BLOG_TAG_CLOUD_LIMIT);

const regularPosts = docs;
---

<PageLayout title={t('blog.metaTitle', locale)} description={t('blog.metaDescription', locale)} showScrollProgress eagerReveal footerBackground='secondary'>
  <Hero layout="centered" size="sm" class="isolate" showHeroHalo>
    <Badge slot="badge" variant="brand" pill>
      <Icon name="book" size="sm" />
      {t('blog.heroBadge', locale)}
    </Badge>

    <h1 slot="title">{t('blog.title', locale)}</h1>

    <p slot="description" class="!text-balance">{t('blog.heroDescription', locale)}</p>
  </Hero>

  <!-- All Posts Section -->
  <section class="bg-background-secondary py-[var(--space-section-md)] border-t border-border">
    <div class="mx-auto max-w-6xl px-6 flex flex-col gap-8">
      <div class="flex flex-col items-center gap-4" data-reveal>
        {topTags.length > 0 && (
          <TagList tags={topTags} locale={locale} class="justify-center" />
        )}
      </div>

      {
        regularPosts.length > 0 ? (
          <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {regularPosts.map((post, index) => (
              <BlogCard
                title={post.title}
                description={post.excerpt || ''}
                href={getPostUrl(post, locale)}
                publishedAt={new Date(post.publishedAt ?? '')}
                tags={(post.tags ?? []).map(t => getTagName(t))}
                author={post.populatedAuthors?.[0]?.name || 'Viptel'}
                imageUrl={post.heroImage && typeof post.heroImage !== 'number' ? payload.resolveMediaUrl(post.heroImage.url ?? '') : undefined}
                revealDelay={index % 3}
                eager={index === 0}
              />
            ))}
          </div>
        ) : (
          <div class="py-16 text-center">
            <div class="bg-background mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full">
              <Icon name="file-text" size="lg" class="text-foreground-muted" />
            </div>
            <p class="text-foreground-muted text-lg">{t('blog.noPosts', locale)}</p>
          </div>
        )
      }

      <Pagination
        currentPage={1}
        totalPages={totalPages}
        href={(page) => getBlogPageUrl(page, locale)}
        totalDocs={totalDocs}
        pageSize={BLOG_POSTS_PER_PAGE}
      />
    </div>
  </section>

  <!-- Follow CTA Section -->
  <!-- Mobile: standard CTA, no LetterGlitch -->
  <CTA variant="default" size="md" maxWidth="lg" glow={false} data-reveal class="glitch:hidden">
    <h2 slot="heading" class="!text-4xl">{t('blog.followAlong', locale)}</h2>
    <p slot="description" class="!text-lg text-balance">{t('blog.followAlongLead', locale)}</p>

    <div class="flex flex-wrap items-center justify-center gap-3">
      <a
        href="/rss.xml"
        class="inline-flex items-center gap-2 rounded-full border border-brand-500/40 bg-background px-4 py-2 text-sm font-medium text-brand-700 dark:text-brand-400 transition-colors hover:border-brand-500/80"
      >
        <Icon name="rss" size="sm" />
        {t('blog.rssFeed', locale)}
      </a>
      {socialLinks.map((link) => (
        <a
          href={link.href}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-full border border-brand-500/40 bg-background px-4 py-2 text-sm font-medium text-brand-700 dark:text-brand-400 transition-colors hover:border-brand-500/80"
        >
          <Icon name={link.icon} size="sm" />
          {link.label}
        </a>
      ))}
      <a
        href={`mailto:${siteConfig.email}`}
        class="inline-flex items-center gap-2 rounded-full border border-brand-500/40 bg-background px-4 py-2 text-sm font-medium text-brand-700 dark:text-brand-400 transition-colors hover:border-brand-500/80"
      >
        <Icon name="mail" size="sm" />
        {t('blog.emailLabel', locale)}
      </a>
    </div>
  </CTA>

  <!-- Desktop: contained LetterGlitch band with glass card -->
  <section class="hidden glitch:block relative z-10 py-[var(--space-section-md)] bg-background">
    <LetterGlitchBand>
      <h2 class="font-display text-4xl font-bold text-foreground mb-4 text-balance">{t('blog.followAlong', locale)}</h2>
      <p class="text-lg text-foreground-muted mb-8 text-balance">{t('blog.followAlongLead', locale)}</p>

      <div class="flex flex-wrap items-center justify-center gap-3">
        <a
          href="/rss.xml"
          class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/5 px-4 py-2 text-sm font-medium text-foreground transition-colors hover:border-brand-400 hover:bg-brand-500/20 hover:text-foreground"
        >
          <Icon name="rss" size="sm" />
          {t('blog.rssFeed', locale)}
        </a>
        {socialLinks.map((link) => (
          <a
            href={link.href}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/5 px-4 py-2 text-sm font-medium text-foreground transition-colors hover:border-brand-400 hover:bg-brand-500/20 hover:text-foreground"
          >
            <Icon name={link.icon} size="sm" />
            {link.label}
          </a>
        ))}
        <a
          href={`mailto:${siteConfig.email}`}
          class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/5 px-4 py-2 text-sm font-medium text-foreground transition-colors hover:border-brand-400 hover:bg-brand-500/20 hover:text-foreground"
        >
          <Icon name="mail" size="sm" />
          {t('blog.emailLabel', locale)}
        </a>
      </div>
    </LetterGlitchBand>
  </section>
</PageLayout>

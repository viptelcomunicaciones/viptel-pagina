---
/**
 * BlogSidebar — menú lateral del blog.
 *
 * Columna izquierda sticky para las páginas de listado del blog: enlaces de
 * navegación global, tipos de post como acordeones (`<details>`) con sus
 * categorías y subcategorías, y una sección de etiquetas con contador.
 *
 * Interacción 100% HTML nativa (sin JS): el toggle móvil lo gestiona
 * `BlogListLayout` con un checkbox + label; aquí solo viven los acordeones.
 */
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import {
  getBlogBaseUrl,
  getCategoryArchiveUrl,
  getPostTypeUrl,
  getSubcategoryArchiveUrl,
  getTagUrl,
  type SidebarCategory,
  type SidebarTag,
  type SidebarType,
} from '@/lib/blog';
import { t, defaultLocale } from '@/i18n';

interface Props {
  locale?: string;
  types: SidebarType[];
  tags: SidebarTag[];
  activeTypeSlug?: string;
  activeCategorySlug?: string;
  activeSubcategorySlug?: string;
  activeTag?: string;
  class?: string;
}

const {
  locale = defaultLocale,
  types,
  tags,
  activeTypeSlug = '',
  activeCategorySlug = '',
  activeSubcategorySlug = '',
  activeTag = '',
  class: extraClass,
} = Astro.props;

const isIndex = activeTypeSlug === '' && activeTag === '';
const blogHref = getBlogBaseUrl(locale);
---

<aside class:list={['blog-sidebar flex w-full flex-col gap-6', extraClass]} aria-label="Explorar el blog">
  <nav aria-label="Blog">
    <ul class="flex flex-col gap-1">
      <li>
        <a
          href={blogHref}
          class:list={[
            'flex items-center gap-2 rounded-lg px-3 py-2 text-sm font-medium transition-colors',
            isIndex
              ? 'bg-brand-500 text-white'
              : 'text-brand-700 dark:text-brand-400 hover:bg-brand-500/10',
          ]}
          aria-current={isIndex ? 'page' : undefined}
        >
          <Icon name="book" size="sm" />
          {t('blog.title', locale)}
        </a>
      </li>
      <li>
        <a
          href={blogHref}
          class:list={[
            'flex items-center gap-2 rounded-lg px-3 py-2 text-sm font-medium transition-colors',
            isIndex
              ? 'bg-brand-500 text-white'
              : 'text-foreground-muted hover:bg-brand-500/10 hover:text-brand-700 dark:hover:text-brand-400',
          ]}
          aria-current={isIndex ? 'page' : undefined}
        >
          <Icon name="layout-grid" size="sm" />
          {t('blog.allPosts', locale)}
        </a>
      </li>
    </ul>
  </nav>

  {types.length > 0 && (
    <section class="blog-sidebar-section rounded-xl border border-border bg-background p-3">
      <h2 class="mb-2 px-2 text-xs font-semibold uppercase tracking-wide text-foreground-subtle">
        {t('blog.sidebarTypes', locale)}
      </h2>
      <ul class="flex flex-col gap-1">
        {types.map((entry) => {
          const isTypeActive = activeTypeSlug === entry.type.slug;
          return (
            <li>
              <details class="group" open={isTypeActive}>
                <summary class="flex cursor-pointer list-none items-center gap-2 rounded-lg px-2 py-2 text-sm font-medium text-foreground transition-colors hover:bg-brand-500/10 [&::-webkit-details-marker]:hidden">
                  <Icon name={entry.type.icon || 'file-text'} size="sm" class="shrink-0 text-brand-600 dark:text-brand-400" />
                  <a
                    href={getPostTypeUrl(entry.type.slug, locale)}
                    class:list={[
                      'flex-1 min-w-0 truncate transition-colors',
                      isTypeActive
                        ? 'text-brand-700 dark:text-brand-400'
                        : 'text-foreground group-hover:text-brand-700 dark:group-hover:text-brand-400',
                    ]}
                    aria-current={isTypeActive ? 'page' : undefined}
                  >
                    {entry.type.title}
                  </a>
                  <span class="shrink-0 rounded-full bg-brand-500/10 px-2 py-0.5 text-xs font-semibold text-brand-700 dark:text-brand-400">
                    {entry.count}
                  </span>
                  <Icon
                    name="chevron-down"
                    size="xs"
                    class="shrink-0 text-foreground-subtle transition-transform duration-200 group-open:rotate-180"
                  />
                </summary>

                {entry.categories.length > 0 && (
                  <ul class="mt-1 flex flex-col gap-0.5 border-l border-border pl-3 ml-3">
                    {entry.categories.map((cat: SidebarCategory) => {
                      const isCatActive = activeCategorySlug === cat.category.slug;
                      return (
                        <li>
                          <a
                            href={getCategoryArchiveUrl(entry.type.slug, cat.category, locale)}
                            class:list={[
                              'flex items-center gap-2 rounded-md px-2 py-1.5 text-sm transition-colors',
                              isCatActive
                                ? 'bg-brand-500/10 font-medium text-brand-700 dark:text-brand-400'
                                : 'text-foreground-muted hover:bg-brand-500/10 hover:text-brand-700 dark:hover:text-brand-400',
                            ]}
                            aria-current={isCatActive ? 'page' : undefined}
                          >
                            <span class="flex-1 min-w-0 truncate">{cat.category.title}</span>
                            <span class="text-xs text-foreground-subtle">{cat.count}</span>
                          </a>

                          {cat.subcategories.length > 0 && (
                            <ul class="ml-3 flex flex-col gap-0.5 border-l border-border pl-2">
                              {cat.subcategories.map((sub) => {
                                const isSubActive = activeSubcategorySlug === sub.category.slug;
                                return (
                                  <li>
                                    <a
                                      href={getSubcategoryArchiveUrl(entry.type.slug, cat.category.slug, sub.category, locale)}
                                      class:list={[
                                        'flex items-center gap-2 rounded-md px-2 py-1.5 text-sm transition-colors',
                                        isSubActive
                                          ? 'bg-brand-500/10 font-medium text-brand-700 dark:text-brand-400'
                                          : 'text-foreground-muted hover:bg-brand-500/10 hover:text-brand-700 dark:hover:text-brand-400',
                                      ]}
                                      aria-current={isSubActive ? 'page' : undefined}
                                    >
                                      <span class="flex-1 min-w-0 truncate">{sub.category.title}</span>
                                      <span class="text-xs text-foreground-subtle">{sub.count}</span>
                                    </a>
                                  </li>
                                );
                              })}
                            </ul>
                          )}
                        </li>
                      );
                    })}
                  </ul>
                )}
              </details>
            </li>
          );
        })}
      </ul>
    </section>
  )}

  {tags.length > 0 && (
    <section class="blog-sidebar-section rounded-xl border border-border bg-background p-3">
      <h2 class="mb-2 px-2 text-xs font-semibold uppercase tracking-wide text-foreground-subtle">
        {t('blog.tagsLabel', locale)}
      </h2>
      <ul class="flex flex-col gap-1">
        {tags.map((tag: SidebarTag) => {
          const isActive = activeTag === tag.name;
          return (
            <li>
              <a
                href={getTagUrl(tag.name, locale)}
                class:list={[
                  'flex items-center gap-2 rounded-md px-2 py-1.5 text-sm transition-colors',
                  isActive
                    ? 'bg-brand-500/10 font-medium text-brand-700 dark:text-brand-400'
                    : 'text-foreground-muted hover:bg-brand-500/10 hover:text-brand-700 dark:hover:text-brand-400',
                ]}
                aria-current={isActive ? 'page' : undefined}
              >
                <Icon name="tag" size="xs" class="shrink-0 text-foreground-subtle" />
                <span class="flex-1 min-w-0 truncate">#{tag.name}</span>
                <span class="text-xs text-foreground-subtle">{tag.count}</span>
              </a>
            </li>
          );
        })}
      </ul>
    </section>
  )}
</aside>
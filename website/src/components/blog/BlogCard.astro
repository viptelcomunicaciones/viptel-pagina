---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { formatDate, getReadingTime } from '@/lib/utils';
import { t, getLocaleFromPath } from '@/i18n';
import Logo from '@/components/ui/marketing/Logo/Logo.astro';
import BlogImageSVG from '@/components/blog/BlogImageSVG.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';

interface Props {
  title: string;
  description: string;
  href: string;
  publishedAt: Date;
  tags?: string[];
  featured?: boolean;
  author?: string;
  image?: ImageMetadata;
  svgSlug?: string;
  imageUrl?: string;
  /** Nombre del tipo de post, mostrado como badge sobre la imagen. */
  postTypeName?: string;
  /** Icono Lucide del tipo de post. */
  postTypeIcon?: string;
  /** Nombre de la categoría del post, mostrado como badge sobre la imagen. */
  postCategoryName?: string;
  /**
   * Marks the first card on a listing page. On mobile it reveals on load with
   * the standard animation instead of waiting for scroll, matching how the
   * first card on pages without a heading above the grid (e.g. projects)
   * already animates in.
   */
  eager?: boolean;
  /**
   * Stagger index for the scroll-reveal cascade. Maps to `data-reveal-delay`
   * (1–4 → 100–400ms) so a grid of cards rises one after another instead of
   * all at once. Pass the map index; 0 (or omitted) means no delay.
   */
  revealDelay?: number;
  class?: string;
  /** Raw post body, used to estimate reading time (CJK-aware). */
  body?: string;
}

const {
  title,
  description,
  href,
  publishedAt,
  tags = [],
  author,
  image,
  svgSlug,
  imageUrl,
  postTypeName,
  postTypeIcon,
  postCategoryName,
  eager = false,
  revealDelay,
  class: className,
  body,
} = Astro.props;

const locale = getLocaleFromPath(Astro.url.pathname);

// Reading time from the actual post body (falls back to the description if no
// body is passed). Counts CJK characters, so space-less languages such as
// Chinese, Japanese, and Korean aren't all estimated as "1 min".
const readingTime = getReadingTime(body ?? description);
---

<article
  class:list={[
    'group border-brand-500/30 bg-background hover:border-brand-500 rounded-lg border p-6 shadow-lg transition-all duration-200 ease-out hover:-translate-y-0.5 hover:shadow-xl',
    className,
  ]}
  data-reveal
  data-reveal-delay={revealDelay || undefined}
  data-reveal-eager={eager ? '' : undefined}
>
  <a href={href} class="block">
    <div
      class="ring-border/60 bg-background-secondary from-brand-100/65 dark:from-brand-900/60 dark:to-brand-600/25 relative mb-4 overflow-hidden rounded-md bg-gradient-to-br to-transparent shadow-md ring-1 transition-shadow duration-300 group-hover:shadow-lg"
      style="color: var(--brand-500);"
    >
      {
        postTypeName && (
          <div class="bg-background/90 text-brand-700 dark:text-brand-400 ring-brand-500/40 absolute top-3 left-3 z-10 inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-xs font-semibold ring-1 backdrop-blur-sm ring-inset">
            <Icon name={postTypeIcon || 'file-text'} size="xs" />
            {postTypeName}
          </div>
        )
      }
      {
        postCategoryName && (
          <div class="bg-background/90 text-foreground-muted ring-border/60 absolute bottom-3 left-3 z-10 inline-flex items-center rounded-full px-3 py-1 text-xs font-medium ring-1 backdrop-blur-sm ring-inset">
            {postCategoryName}
          </div>
        )
      }
      {
        svgSlug ? (
          <div class="transition-transform duration-300 group-hover:scale-105">
            <BlogImageSVG slug={svgSlug} title={title} />
          </div>
        ) : imageUrl ? (
          <img
            src={imageUrl}
            alt={title}
            class="aspect-video w-full object-cover transition-transform duration-300 group-hover:scale-105"
            loading="lazy"
          />
        ) : image ? (
          <Image
            src={image}
            alt={title}
            widths={[320, 640, 960]}
            sizes="(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 400px"
            class="aspect-video w-full object-cover transition-transform duration-300 group-hover:scale-105"
            loading="lazy"
          />
        ) : (
          <div class="aspect-video w-full" />
        )
      }
    </div>

    <h2
      class="font-display text-foreground group-hover:text-brand-600 dark:group-hover:text-brand-400 mb-2 text-xl font-bold transition-colors"
    >
      {title}
    </h2>

    <p class="text-foreground-muted mb-4 line-clamp-2">
      {description}
    </p>

    <div class="text-foreground-subtle flex flex-wrap items-center gap-3 text-sm">
      {
        author && (
          <div class="flex items-center gap-2">
            <Logo size="sm" letter={author.charAt(0).toUpperCase()} />
            <span class="font-medium">{author}</span>
          </div>
        )
      }

      <time datetime={publishedAt.toISOString()} class="flex items-center gap-1">
        <svg
          class="h-4 w-4"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="1.5"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5"
          ></path>
        </svg>
        {formatDate(publishedAt, locale)}
      </time>

      <span class="flex items-center gap-1">
        <svg
          class="h-4 w-4"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="1.5"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        {t('blog.readingTime', locale, { minutes: readingTime })}
      </span>
    </div>

    {
      tags.length > 0 && (
        <div class="mt-4 flex flex-wrap gap-2">
          {tags.map((tag) => (
            <span class="text-brand-700 dark:text-brand-400 ring-brand-500/40 group-hover:ring-brand-500/80 inline-flex items-center rounded-full bg-transparent px-2.5 py-0.5 text-xs font-medium ring-1 transition-colors ring-inset">
              #{tag}
            </span>
          ))}
        </div>
      )
    }
  </a>
</article>

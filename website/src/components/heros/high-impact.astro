---
/**
 * HighImpactHero — full-viewport hero with a background image (dark overlay)
 * and light-on-dark content. Rendered when the CMS hero type is `highImpact`.
 */
import { Hero } from '@/components/hero';
import RichText from '@/components/blocks/RichText.astro';
import HeroLinks from './HeroLinks.astro';
import Badge from '@/components/ui/data-display/Badge/Badge.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import { extractHeroTitle } from './hero-helpers';
import { payload } from '@/lib/payload-client';
import type { PageHero } from '@/lib/block-types';

interface Props {
  hero: PageHero;
  locale?: string;
}

const { hero, locale } = Astro.props;

const title = extractHeroTitle(hero.richText);
const hasLinks = Array.isArray(hero.links) && hero.links.length > 0;
const backgroundImage =
  hero.media && typeof hero.media === 'object' && hero.media.url
    ? payload.resolveMediaUrl(hero.media.url)
    : undefined;
---

<Hero
  fullHeight
  layout="centered"
  showGrid
  showGlow
  onDark={Boolean(backgroundImage)}
  backgroundImage={backgroundImage}
  class={!backgroundImage ? 'hero-dark-gradient' : undefined}
>
  {
    hero.badge && (
      <Badge slot="badge" variant="brand" pill>
        {hero.badgeIcon && <Icon name={hero.badgeIcon} size="sm" />}
        {hero.badge}
      </Badge>
    )
  }
  {title && <h1 slot="title">{title}</h1>}
  <RichText slot="description" content={hero.richText} excludeFirstHeading />
  {hasLinks && <HeroLinks slot="actions" links={hero.links!} locale={locale} />}
</Hero>

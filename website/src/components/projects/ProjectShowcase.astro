---
import type { ImageMetadata } from 'astro';
import Button from '@/components/ui/form/Button/Button.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';

interface Props {
  lightImage: ImageMetadata;
  darkImage: ImageMetadata;
  lightAlt?: string;
  darkAlt?: string;
  demoUrl: string;
}

const {
  lightImage,
  darkImage,
  lightAlt = 'Light mode screenshot',
  darkAlt = 'Dark mode screenshot',
  demoUrl,
} = Astro.props;
---

<div class="not-prose my-12 space-y-6">
  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
    <div class="border-border overflow-hidden rounded-xl border shadow-xl">
      <img
        src={lightImage.src}
        alt={lightAlt}
        width={lightImage.width}
        height={lightImage.height}
        class="aspect-video w-full object-cover"
        loading="lazy"
        decoding="async"
      />
      <p class="text-foreground-subtle bg-background-secondary py-2 text-center text-xs">
        Light mode
      </p>
    </div>

    <div class="border-border overflow-hidden rounded-xl border shadow-xl">
      <img
        src={darkImage.src}
        alt={darkAlt}
        width={darkImage.width}
        height={darkImage.height}
        class="aspect-video w-full object-cover"
        loading="lazy"
        decoding="async"
      />
      <p class="text-foreground-subtle bg-background-secondary py-2 text-center text-xs">
        Dark mode
      </p>
    </div>
  </div>

  <div class="bg-background-secondary border-border rounded-xl border px-8 py-10 text-center">
    <p class="font-display text-foreground mb-3 text-xl font-bold">See it live</p>
    <p class="text-foreground-muted mx-auto mb-6 max-w-md">
      The best way to experience Astro Rocket is to open it. Switch themes, toggle dark mode, read a
      blog post.
    </p>
    <Button href={demoUrl} target="_blank" rel="noopener noreferrer" size="md">
      <Icon name="external-link" size="sm" />
      View live demo
    </Button>
  </div>
</div>

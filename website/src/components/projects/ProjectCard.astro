---
/**
 * Project listing card. Extracted so the projects index, paginated pages,
 * and tag archives render identical cards from one source of truth.
 *
 * Data comes from Payload CMS via the REST API — flat Project objects.
 */
import Card from '@/components/ui/data-display/Card/Card.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import type { Project } from '@/lib/payload-types';
import { defaultLocale } from '@/i18n';
import { getProjectUrl, getTagName } from '@/lib/projects';
import { payload } from '@/lib/payload-client';

interface Props {
  project: Project;
  /** Stagger index for the scroll-reveal cascade. */
  index?: number;
  /**
   * Locale the card's link belongs to. Default-locale links stay at
   * `/projects/...`; other locales are prefixed (`/<locale>/projects/...`).
   */
  locale?: string;
}

const { project, index = 0, locale = defaultLocale } = Astro.props;
---

<Card
  variant="elevated"
  hover
  padding="none"
  href={getProjectUrl(project, locale)}
  class="group flex flex-col"
  data-reveal
  data-reveal-delay={index % 2 || undefined}
>
  <div class="flex flex-1 flex-col p-6">
    {project.coverImage && typeof project.coverImage !== 'number' && project.coverImage.url && (
      <div class="mb-4 overflow-hidden rounded-lg">
        <img
          src={payload.resolveMediaUrl(project.coverImage.url)}
          alt={project.coverImage.alt || project.title}
          class="w-full aspect-video object-cover transition-transform duration-300 group-hover:scale-105"
          loading="lazy"
        />
      </div>
    )}
    <div class="mb-3 flex items-start justify-between gap-4">
      <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-brand-500/20 to-brand-500/5 flex items-center justify-center text-brand-500 shrink-0">
        <Icon name="layers" size="sm" />
      </div>
      <Icon name="arrow-up-right" size="sm" class="text-foreground-muted group-hover:text-brand-500 transition-colors shrink-0 ml-auto" />
    </div>
    <div class="mb-2 flex items-baseline gap-2">
      <h3 class="font-display text-lg font-bold text-foreground">{project.title}</h3>
      {project.year && (
        <span class="text-xs text-foreground-muted">{project.year}</span>
      )}
    </div>
    <p class="text-sm text-foreground-muted leading-relaxed mb-4 flex-1">{project.description || ''}</p>
    {(project.tags ?? []).length > 0 && (
      <div class="flex flex-wrap gap-1.5">
        {(project.tags ?? []).map((t) => (
          <span class="inline-flex items-center rounded-full bg-transparent px-2.5 py-0.5 text-xs font-medium text-brand-700 dark:text-brand-400 ring-1 ring-inset ring-brand-500/40 transition-colors group-hover:ring-brand-500/80">
            #{getTagName(t)}
          </span>
        ))}
      </div>
    )}
  </div>
</Card>

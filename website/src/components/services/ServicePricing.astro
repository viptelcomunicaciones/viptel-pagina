---
import Button from '@/components/ui/form/Button/Button.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import { t } from '@/i18n';
import { cn } from '@/lib/cn';
import type { Service } from '@/lib/payload-types';

interface Props {
  plans: NonNullable<Service['pricing']>;
  locale?: string;
  class?: string;
}

const { plans, locale = 'es', class: className } = Astro.props;
---

<section class={cn('bg-background-secondary border-border border-y py-[var(--space-section-md)]', className)}>
  <div class="mx-auto max-w-6xl px-4">
    <h2 class="text-foreground mb-10 text-center text-2xl font-bold">
      {t('services.detail.pricing', locale)}
    </h2>
    <div class="grid gap-6 lg:grid-cols-3" data-reveal>
      {
        plans.map((plan) => (
          <div
            class={cn(
              'flex flex-col rounded-xl border p-6',
              plan.highlighted
                ? 'border-brand-500 bg-brand-50 dark:bg-brand-950/30 ring-brand-500 ring-2'
                : 'border-border bg-background'
            )}
          >
            {plan.highlighted && (
              <span class="bg-brand-600 mb-3 self-start rounded-full px-3 py-1 text-xs font-medium text-white">
                {t('services.pricing.highlighted', locale)}
              </span>
            )}
            <h3 class="text-foreground text-lg font-semibold">{plan.planName}</h3>
            <div class="mt-4 flex items-baseline gap-1">
              {
                plan.price && plan.price > 0 ? (
                  <>
                    <span class="text-foreground text-3xl font-bold">
                      {plan.currency || '$'}
                      {plan.price.toLocaleString()}
                    </span>
                    <span class="text-foreground-muted text-sm">
                      {plan.period || t('services.pricing.period', locale)}
                    </span>
                  </>
                ) : (
                  <span class="text-foreground text-2xl font-bold">
                    {t('services.pricing.onRequest', locale)}
                  </span>
                )
              }
            </div>
            {plan.features && plan.features.length > 0 && (
              <ul class="mt-6 flex flex-col gap-2">
                {plan.features.map((f) => (
                  <li class="text-foreground-muted flex items-center gap-2 text-sm">
                    <Icon name="check" size="sm" class="text-brand-600 shrink-0" />
                    {f.feature}
                  </li>
                ))}
              </ul>
            )}
            <div class="mt-auto pt-6">
              <Button fullWidth variant={plan.highlighted ? 'primary' : 'outline'} href="/contact">
                {plan.ctaLabel || t('services.pricing.cta', locale)}
              </Button>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

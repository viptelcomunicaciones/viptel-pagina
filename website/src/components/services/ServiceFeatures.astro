---
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import { t } from '@/i18n';
import { cn } from '@/lib/cn';
import type { Service } from '@/lib/payload-types';

interface Props {
  features: NonNullable<Service['features']>;
  locale?: string;
  class?: string;
}

const { features, locale = 'es', class: className } = Astro.props;
---

<section class={cn('py-[var(--space-section-md)]', className)}>
  <div class="mx-auto max-w-6xl px-4">
    <h2 class="text-foreground mb-10 text-center text-2xl font-bold">
      {t('services.detail.features', locale)}
    </h2>
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3" data-reveal>
      {
        features.map((feature) => (
          <div class="border-border bg-background flex flex-col items-center gap-3 rounded-xl border p-6 text-center">
            <div class="bg-brand-50 text-brand-600 dark:bg-brand-950 dark:text-brand-400 flex h-12 w-12 items-center justify-center rounded-full">
              <Icon name={feature.icon ?? 'check-circle'} size="md" />
            </div>
            <h3 class="text-foreground text-base font-semibold">{feature.title}</h3>
            {feature.description && (
              <p class="text-foreground-muted text-sm">{feature.description}</p>
            )}
          </div>
        ))
      }
    </div>
  </div>
</section>

---
import { t } from '@/i18n';
import { cn } from '@/lib/cn';

import { payload } from '@/lib/payload-client';
import type { Service } from '@/lib/payload-types';

interface Props {
  gallery: NonNullable<Service['gallery']>;
  locale?: string;
  class?: string;
}

const { gallery, locale = 'es', class: className } = Astro.props;

function getImageUrl(img: NonNullable<Service['gallery']>[number]): string | null {
  if (typeof img.image === 'object' && img.image && 'url' in img.image) {
    const rawUrl = img.image.url as string | null;
    return rawUrl ? payload.resolveMediaUrl(rawUrl) : null;
  }
  return null;
}

function getImageAlt(img: NonNullable<Service['gallery']>[number]): string {
  return (
    img.alt ||
    (typeof img.image === 'object' && img.image && 'alt' in img.image
      ? (img.image.alt as string) || ''
      : '')
  );
}

const validImages = gallery.filter((img) => getImageUrl(img) !== null);
---

{
  validImages.length > 0 && (
    <section class={cn('py-16', className)}>
      <div class="mx-auto max-w-6xl px-4">
        <h2 class="text-foreground mb-10 text-center text-2xl font-bold">
          {t('services.detail.gallery', locale)}
        </h2>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {validImages.map((img) => {
            const url = getImageUrl(img)!;
            const alt = getImageAlt(img);
            return (
              <div class="border-border bg-secondary overflow-hidden rounded-xl border">
                <img
                  src={url}
                  alt={alt}
                  class="h-56 w-full object-cover transition-transform hover:scale-105"
                  loading="lazy"
                />
              </div>
            );
          })}
        </div>
      </div>
    </section>
  )
}

---
/**
 * ServiceDetailLayout — renders a service category or sub-service page.
 * Composes breadcrumb, hero, description, child services grid (categories),
 * features, pricing, FAQ, gallery, and layout blocks (CTA from Payload).
 */
import PageLayout from '@/layouts/PageLayout.astro';
import BlockRenderer from '@/components/blocks/BlockRenderer.astro';
import RichText from '@/components/blocks/RichText.astro';
import Badge from '@/components/ui/data-display/Badge/Badge.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import ServiceBreadcrumb from './ServiceBreadcrumb.astro';
import ServiceFeatures from './ServiceFeatures.astro';
import ServicePricing from './ServicePricing.astro';
import ServiceFAQ from './ServiceFAQ.astro';
import ServiceGallery from './ServiceGallery.astro';
import ServiceGrid from './ServiceGrid.astro';
import { Hero } from '@/components/hero';
import { t } from '@/i18n';
import type { Service } from '@/lib/payload-types';
import type { PageBlock } from '@/lib/block-types';

interface Props {
  service: Service;
  parentService?: Service | null;
  childrenServices?: Service[];
  hrefPrefix?: string;
  locale?: string;
}

const {
  service,
  parentService,
  childrenServices = [],
  hrefPrefix = '/services',
  locale = 'es',
} = Astro.props;
const title = service.meta?.title || service.title;
const description = service.meta?.description || service.shortDescription || service.title;
const isCategory = childrenServices.length > 0;
---

<PageLayout title={title} description={description}>
  <Hero layout="centered" size="sm" class="isolate" showHeroHalo>
    <Badge slot="badge" variant="brand" pill>
      <Icon name={service.icon ?? 'briefcase'} size="sm" />
      {t('services.heroBadge', locale)}
    </Badge>
    <div slot="title">
      {parentService && (
        <p class="text-foreground-muted font-display mb-2 text-sm font-medium tracking-wide uppercase">
          <a href={`${hrefPrefix}/${parentService.slug}`} class="hover:text-brand-600 transition-colors">
            {parentService.title}
          </a>
        </p>
      )}
      <h1 class="text-foreground [-webkit-text-fill-color:currentColor]">{service.title}</h1>
    </div>
    {
      service.shortDescription && (
        <p slot="description" class="!text-balance">{service.shortDescription}</p>
      )
    }
  </Hero>

  {
    service.description && (
      <section class="bg-background relative z-10 py-12">
        <div class="mx-auto max-w-6xl px-6">
          <RichText content={service.description} class="mx-auto max-w-none text-center [&>p]:text-lg [&>p]:leading-relaxed [&>p]:text-foreground-muted [&>p]:mx-auto [&>p]:max-w-3xl" />
        </div>
      </section>
    )
  }

  {
    isCategory && (
      <section class="py-[var(--space-section-md)]">
        <div class="mx-auto max-w-6xl px-4">
          <h2 class="text-foreground mb-10 text-center text-2xl font-bold">
            {t('services.detail.subServices', locale)}
          </h2>
          <ServiceGrid services={childrenServices} hrefPrefix={hrefPrefix} />
        </div>
      </section>
    )
  }

  {
    service.features && service.features.length > 0 && (
      <ServiceFeatures features={service.features} locale={locale} />
    )
  }

  {
    service.pricing && service.pricing.length > 0 && (
      <ServicePricing plans={service.pricing} locale={locale} />
    )
  }

  {service.faq && service.faq.length > 0 && <ServiceFAQ faq={service.faq} locale={locale} />}

  {
    service.gallery && service.gallery.length > 0 && (
      <ServiceGallery gallery={service.gallery} locale={locale} />
    )
  }

  {
    service.layout && service.layout.length > 0 && (
      <BlockRenderer layout={service.layout as PageBlock[]} locale={locale} />
    )
  }
</PageLayout>
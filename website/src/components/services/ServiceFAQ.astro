---
import { t } from '@/i18n';
import { cn } from '@/lib/cn';

interface FaqItem {
  id?: string | null;
  question: string;
  answer?: any;
}

interface Props {
  faq: FaqItem[];
  locale?: string;
  class?: string;
}

const { faq, locale = 'es', class: className } = Astro.props;

function extractPlainText(richText: any): string {
  try {
    const root = richText?.root;
    if (!root || !Array.isArray(root.children)) return '';
    return root.children
      .filter((c: any) => c.type === 'paragraph' || c.type === 'heading')
      .map((c: any) => c.children?.map((t: any) => t.text || '').join('') || '')
      .join(' ');
  } catch {
    return '';
  }
}
---

<section class={cn('py-[var(--space-section-md)]', className)}>
  <div class="mx-auto max-w-3xl px-4">
    <h2 class="text-foreground mb-10 text-center text-2xl font-bold">
      {t('services.detail.faq', locale)}
    </h2>
    <div class="flex flex-col gap-3" data-reveal>
      {
        faq.map((item) => (
          <details class="group border-border bg-background rounded-xl border">
            <summary class="text-foreground flex cursor-pointer items-center justify-between p-5 text-base font-medium marker:hidden">
              {item.question}
              <span class="text-foreground-muted shrink-0 transition-transform group-open:rotate-180">
                <svg
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="m6 9 6 6 6-6" />
                </svg>
              </span>
            </summary>
            <div class="text-foreground-muted px-5 pb-5 text-sm leading-relaxed">
              {extractPlainText(item.answer) || '—'}
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

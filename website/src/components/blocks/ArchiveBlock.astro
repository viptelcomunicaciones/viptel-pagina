---
import type { ArchiveBlock as ArchiveBlockType, Post, Project, Service } from '@/lib/payload-types';
import { payload } from '@/lib/payload-client';
import { localizedPath, t } from '@/i18n';
import RichText from './RichText.astro';
import ServiceCard from '@/components/services/ServiceCard.astro';
import BlogCard from '@/components/blog/BlogCard.astro';
import ProjectCard from '@/components/projects/ProjectCard.astro';
import Button from '@/components/ui/form/Button/Button.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import { getPostUrl, getTagName, getPostTypeName, getPostTypeIcon } from '@/lib/blog';
import { Image } from 'astro:assets';

interface Props {
  block: ArchiveBlockType;
  locale?: string;
}

const { block, locale = 'es' } = Astro.props;

interface ArchiveCard {
  slug: string;
  title: string;
  imageUrl?: string;
  imageAlt?: string;
  description?: string;
  publishedAt?: string | null;
}

function toCard(item: Post | Project): ArchiveCard {
  const heroImage = 'heroImage' in item ? item.heroImage : undefined;
  const coverImage = 'coverImage' in item ? item.coverImage : undefined;
  const image =
    typeof heroImage === 'object' && heroImage !== null
      ? heroImage
      : typeof coverImage === 'object' && coverImage !== null
        ? coverImage
        : undefined;
  const description = 'excerpt' in item ? item.excerpt : (item as Project).description;
  return {
    slug: item.slug,
    title: item.title,
    imageUrl: image?.url ?? undefined,
    imageAlt: image?.alt ?? undefined,
    description: description ?? undefined,
    publishedAt: item.publishedAt,
  };
}

const isProjects = block.relationTo === 'projects';
const isServices = block.relationTo === 'services';
const isPosts = block.relationTo === 'posts';

let items: ArchiveCard[] = [];
let postItems: Post[] = [];
let projectItems: Project[] = [];
let serviceItems: Service[] = [];

if (block.populateBy === 'selection' && block.selectedDocs?.length) {
  const selectedPosts: Post[] = [];
  const selectedProjects: Project[] = [];
  const selectedServices: Service[] = [];

  const missingPostIds: (string | number)[] = [];
  const missingProjectIds: (string | number)[] = [];
  const missingServiceIds: (string | number)[] = [];

  for (const rawDoc of block.selectedDocs) {
    if (!rawDoc) continue;
    const relationTo =
      typeof rawDoc === 'object' && 'relationTo' in rawDoc
        ? (rawDoc as { relationTo: string }).relationTo
        : block.relationTo;
    const val =
      typeof rawDoc === 'object' && 'value' in rawDoc
        ? (rawDoc as { value: unknown }).value
        : rawDoc;

    if (typeof val === 'object' && val !== null && 'id' in val) {
      if (relationTo === 'posts' || (!relationTo && isPosts)) selectedPosts.push(val as Post);
      else if (relationTo === 'projects' || (!relationTo && isProjects)) selectedProjects.push(val as Project);
      else if (relationTo === 'services' || (!relationTo && isServices)) selectedServices.push(val as Service);
    } else if (typeof val === 'string' || typeof val === 'number') {
      if (relationTo === 'posts' || (!relationTo && isPosts)) missingPostIds.push(val);
      else if (relationTo === 'projects' || (!relationTo && isProjects)) missingProjectIds.push(val);
      else if (relationTo === 'services' || (!relationTo && isServices)) missingServiceIds.push(val);
    }
  }

  if (missingPostIds.length || missingProjectIds.length || missingServiceIds.length) {
    const [posts, projects, services] = await Promise.all([
      missingPostIds.length ? payload.posts().getAll(locale) : Promise.resolve([]),
      missingProjectIds.length ? payload.projects().getAll(locale) : Promise.resolve([]),
      missingServiceIds.length ? payload.services().getAll(locale) : Promise.resolve([]),
    ]);
    const postMap = new Map(posts.map((p) => [String(p.id), p]));
    const projectMap = new Map(projects.map((p) => [String(p.id), p]));
    const serviceMap = new Map(services.map((s) => [String(s.id), s]));

    for (const id of missingPostIds) {
      const p = postMap.get(String(id));
      if (p) selectedPosts.push(p);
    }
    for (const id of missingProjectIds) {
      const p = projectMap.get(String(id));
      if (p) selectedProjects.push(p);
    }
    for (const id of missingServiceIds) {
      const s = serviceMap.get(String(id));
      if (s) selectedServices.push(s);
    }
  }

  postItems = selectedPosts;
  projectItems = selectedProjects;
  serviceItems = selectedServices;
} else if (isServices) {
  const all = await payload.services().getAll(locale);
  let selected = all.filter((s) => s.parent != null);
  if (block.limit) selected = selected.slice(0, block.limit);
  serviceItems = selected;
} else if (isProjects) {
  let all = await payload.projects().getAll(locale);
  if (block.categories?.length) {
    const selectedCategoryIds = new Set(
      block.categories.map((c) => (typeof c === 'object' && c ? String((c as { id?: number | string }).id) : String(c)))
    );
    all = all.filter((p) => {
      const cat = p.categories;
      const catId = typeof cat === 'object' && cat !== null ? String((cat as { id?: number | string }).id) : String(cat);
      return catId != null && selectedCategoryIds.has(catId);
    });
  }
  if (block.limit) all = all.slice(0, block.limit);
  projectItems = all;
} else {
  let all = await payload.posts().getAll(locale);
  if (block.categories?.length) {
    const selectedCategoryIds = new Set(
      block.categories.map((c) => (typeof c === 'object' && c ? String((c as { id?: number | string }).id) : String(c)))
    );
    all = all.filter((p) => {
      const cat = p.categories;
      const catId = typeof cat === 'object' && cat !== null ? String((cat as { id?: number | string }).id) : String(cat);
      return catId != null && selectedCategoryIds.has(catId);
    });
  }
  if (block.limit) all = all.slice(0, block.limit);
  postItems = all;
}

const linkPrefix = isServices ? '/services' : isProjects ? '/projects' : '/blog';
---

<section class="bg-background-secondary border-border border-t py-[var(--space-section-md)]">
  <div class="mx-auto max-w-6xl px-6">
    {
      (block.heading || block.introContent) && (
        <div class="mb-12 text-center" data-reveal>
          {block.heading && (
            <h2 class="font-display text-foreground mb-4 text-3xl font-bold md:text-4xl">
              {block.heading}
            </h2>
          )}
          {block.introContent && (
            <RichText
              content={block.introContent}
              class="prose prose-lg dark:prose-invert text-foreground-muted mx-auto max-w-3xl [&_h1]:font-display [&_h1]:text-foreground [&_h1]:text-3xl [&_h1]:font-bold md:[&_h1]:text-4xl [&_h2]:font-display [&_h2]:text-foreground [&_h2]:text-3xl [&_h2]:font-bold"
            />
          )}
        </div>
      )
    }
    {
      serviceItems.length > 0 ? (
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {serviceItems.map((service) => (
            <ServiceCard
              service={service}
              href={localizedPath(`/services/${service.slug}`, locale)}
            />
          ))}
        </div>
      ) : isPosts ? (
        <div>
          <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            {postItems.map((post, index) => (
              <BlogCard
                title={post.title}
                description={post.excerpt || ''}
                href={getPostUrl(post, locale)}
                publishedAt={new Date(post.publishedAt ?? '')}
                tags={(post.tags ?? []).map((tag) => getTagName(tag))}
                author={post.populatedAuthors?.[0]?.name || 'Viptel'}
                imageUrl={
                  post.heroImage && typeof post.heroImage !== 'number'
                    ? payload.resolveMediaUrl(post.heroImage.url ?? '')
                    : undefined
                }
                postTypeName={getPostTypeName(post)}
                postTypeIcon={getPostTypeIcon(post)}
                revealDelay={index % 3}
                eager={false}
              />
            ))}
          </div>
          <div class="mt-10 flex justify-center">
            <Button href={localizedPath('/blog', locale)} variant="brand-outline" size="sm">
              <Icon name="arrow-right" size="sm" />
              {t('pages.home.blog.viewAll', locale)}
            </Button>
          </div>
        </div>
      ) : isProjects || projectItems.length > 0 ? (
        <div>
          <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            {projectItems.map((project, index) => (
              <ProjectCard project={project} index={index} locale={locale} />
            ))}
          </div>
          <div class="mt-10 flex justify-center">
            <Button href={localizedPath('/projects', locale)} variant="brand-outline" size="sm">
              <Icon name="arrow-right" size="sm" />
              {t('pages.home.portfolio.viewAll', locale)}
            </Button>
          </div>
        </div>
      ) : (
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {items.map((item) => (
            <a
              href={localizedPath(`${linkPrefix}/${item.slug}`, locale)}
              class="group bg-background border-border hover:border-brand-500/40 overflow-hidden rounded-xl border transition-all duration-200 hover:-translate-y-1 hover:shadow-md"
            >
              {item.imageUrl && (
                <Image
                  src={payload.resolveMediaUrl(item.imageUrl)}
                  alt={item.imageAlt || item.title}
                  inferSize
                  widths={[320, 640, 960]}
                  sizes="(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 33vw"
                  class="aspect-video w-full object-cover"
                  loading="lazy"
                />
              )}
              <div class="p-5">
                <h3 class="font-display text-foreground group-hover:text-brand-500 font-bold transition-colors">
                  {item.title}
                </h3>
                {item.description && (
                  <p class="text-foreground-muted mt-2 text-sm">{item.description}</p>
                )}
                {item.publishedAt && (
                  <time class="text-foreground-muted mt-3 block text-xs">
                    {new Date(item.publishedAt).toLocaleDateString(
                      locale === 'en' ? 'en-US' : 'es-CO',
                      { year: 'numeric', month: 'long', day: 'numeric' }
                    )}
                  </time>
                )}
              </div>
            </a>
          ))}
        </div>
      )
    }
  </div>
</section>

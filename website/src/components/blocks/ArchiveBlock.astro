---
import type { ArchiveBlock as ArchiveBlockType, Post, Project } from '@/lib/payload-types'
import { payload } from '@/lib/payload-client'
import { localizedPath } from '@/i18n'
import RichText from './RichText.astro'

interface Props {
  block: ArchiveBlockType
  locale?: string
}

const { block, locale = 'es' } = Astro.props

type ArchiveItem = Post | Project
let items: ArchiveItem[] = []
const isProjects = block.relationTo === 'projects'

if (block.populateBy === 'selection' && block.selectedDocs?.length) {
  const all: ArchiveItem[] = isProjects ? await payload.projects().getAll(locale) : await payload.posts().getAll(locale)
  const selectedIds = new Set(block.selectedDocs.map((d) => (typeof d === 'object' ? (d as any).id : d)))
  items = all.filter((p) => selectedIds.has(p.id))
} else {
  items = isProjects ? await payload.projects().getAll(locale) : await payload.posts().getAll(locale)
  if (block.categories?.length) {
    items = items.filter((p) =>
      p.categories?.some((c) => block.categories!.includes(typeof c === 'number' ? c : (c as any).id)),
    )
  }
  if (block.limit) items = items.slice(0, block.limit)
}

const linkPrefix = isProjects ? '/projects' : '/blog'
---

<section class="py-[var(--space-section-md)] bg-background-secondary border-t border-border">
  <div class="mx-auto max-w-6xl px-6">
    {block.introContent && (
      <div class="text-center mb-12">
        <RichText content={block.introContent} />
      </div>
    )}
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {items.map((item) => (
        <a
          href={localizedPath(`${linkPrefix}/${item.slug}`, locale)}
          class="group bg-background rounded-xl border border-border overflow-hidden hover:border-brand-500/40 hover:shadow-md transition-all duration-200 hover:-translate-y-1"
        >
          {(item.heroImage?.url || item.coverImage?.url) && (
            <img
              src={payload.resolveMediaUrl(item.heroImage?.url || item.coverImage?.url)}
              alt={(item.heroImage?.alt || item.coverImage?.alt) || item.title}
              class="w-full aspect-video object-cover"
            />
          )}
          <div class="p-5">
            <h3 class="font-display font-bold text-foreground group-hover:text-brand-500 transition-colors">
              {item.title}
            </h3>
            {(item.excerpt || item.description) && (
              <p class="text-sm text-foreground-muted mt-2">{item.excerpt || item.description}</p>
            )}
            {item.publishedAt && (
              <time class="text-xs text-foreground-muted mt-3 block">
                {new Date(item.publishedAt).toLocaleDateString(
                  locale === 'en' ? 'en-US' : 'es-CO',
                  { year: 'numeric', month: 'long', day: 'numeric' },
                )}
              </time>
            )}
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

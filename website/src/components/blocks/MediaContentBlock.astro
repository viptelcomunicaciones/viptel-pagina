---
import RichText from './RichText.astro';
import { payload } from '@/lib/payload-client';
import type { MediaContentBlock as MediaContentBlockType } from '@/lib/block-types';
import { Image } from 'astro:assets';

interface Props {
  block: MediaContentBlockType;
  locale?: string;
}

const { block } = Astro.props;
const isLeft = block.imagePosition === 'left';
const image = typeof block.image === 'object' && block.image !== null ? block.image : undefined;
const mediaUrl = image?.url;
---

<section
  class="bg-background-secondary border-border relative z-10 border-t py-[var(--space-section-md)]"
>
  <div class="mx-auto max-w-6xl px-6">
    <div class={`grid gap-10 md:grid-cols-2 md:gap-12 items-center`}>
      {
        isLeft && mediaUrl && (
          <div data-reveal>
            <Image
              src={payload.resolveMediaUrl(mediaUrl)}
              alt={image?.alt || ''}
              inferSize
              widths={[480, 640, 960, 1280]}
              sizes="(max-width: 768px) 100vw, 50vw"
              class="h-auto w-full rounded-xl shadow-lg"
            />
          </div>
        )
      }
      <div data-reveal data-reveal-delay={isLeft ? '1' : '0'}>
        {
          block.heading && (
            <h2 class="font-display text-foreground mb-6 text-3xl font-bold md:text-4xl">
              {block.heading}
            </h2>
          )
        }
        {
          block.body && (
            <RichText content={block.body} class="text-foreground-muted text-lg leading-relaxed" />
          )
        }
      </div>
      {
        !isLeft && mediaUrl && (
          <div data-reveal data-reveal-delay="1">
            <Image
              src={payload.resolveMediaUrl(mediaUrl)}
              alt={image?.alt || ''}
              inferSize
              widths={[480, 640, 960, 1280]}
              sizes="(max-width: 768px) 100vw, 50vw"
              class="h-auto w-full rounded-xl shadow-lg"
            />
          </div>
        )
      }
    </div>
  </div>
</section>

---
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import BlockSection from './BlockSection.astro';
import type { CardsBlock as CardsBlockType } from '@/lib/block-types';

interface Props {
  block: CardsBlockType;
  locale?: string;
}

const { block } = Astro.props;
---

<BlockSection>
  <div class="mx-auto flex max-w-6xl flex-col gap-8 px-6">
    {
      block.heading && (
        <div class="flex flex-col items-center gap-4 text-center" data-reveal>
          <h2 class="font-display text-foreground text-3xl font-bold md:text-4xl">
            {block.heading}
          </h2>
        </div>
      )
    }
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        block.cards.map((card, i) => (
          <a
            href={card.linkUrl || '#'}
            class:list={[
              'group bg-background-secondary border-border hover:border-brand-500/40 relative rounded-xl border p-6 transition-all duration-200 hover:-translate-y-1 hover:shadow-md',
              !card.linkUrl && 'pointer-events-none cursor-default',
            ]}
            data-reveal
            data-reveal-delay={i || undefined}
          >
            {card.icon && (
              <div class="from-brand-500/20 to-brand-500/5 text-brand-500 mb-4 flex h-10 w-10 items-center justify-center rounded-xl bg-gradient-to-br">
                <Icon name={card.icon} size="sm" />
              </div>
            )}
            <h3 class="font-display text-foreground mb-2 text-lg font-bold">{card.title}</h3>
            {card.description && (
              <p class="text-foreground-muted text-sm leading-relaxed">{card.description}</p>
            )}
          </a>
        ))
      }
    </div>
  </div>
</BlockSection>

---
import RichText from './RichText.astro';
import Button from '@/components/ui/form/Button/Button.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import { resolveHeroLink } from '@/components/heros/hero-helpers';
import type { ContentBlock as ContentBlockType } from '@/lib/payload-types';

interface Props {
  block: ContentBlockType;
  locale?: string;
}

const { block, locale = 'es' } = Astro.props;

const columns = block.columns ?? [];
---

<section class="bg-background border-border relative z-10 border-t py-[var(--space-section-md)]">
  <div class="mx-auto max-w-6xl px-6">
    {
      columns.length > 0 && (
        <div class="grid grid-cols-1 gap-8 md:grid-cols-12">
          {columns.map((col) => {
            const hasLink = Boolean(col.enableLink && col.link);
            const resolvedLink = hasLink
              ? resolveHeroLink({ link: col.link } as any, locale)
              : null;

            return (
              <div
                class:list={[
                  col.size === 'oneThird' && 'md:col-span-4',
                  col.size === 'half' && 'md:col-span-6',
                  col.size === 'twoThirds' && 'md:col-span-8',
                  col.size === 'full' && 'md:col-span-12',
                  !col.size && 'md:col-span-4',
                ]}
              >
                <RichText
                  content={col.richText}
                  class="prose prose-lg dark:prose-invert max-w-none"
                />
                {resolvedLink && (
                  <div class="mt-6">
                    <Button
                      href={resolvedLink.href}
                      variant={resolvedLink.appearance === 'outline' ? 'outline' : 'primary'}
                      target={resolvedLink.newTab ? '_blank' : undefined}
                      rel={resolvedLink.newTab ? 'noopener noreferrer' : undefined}
                    >
                      {resolvedLink.label}
                      <Icon name="arrow-right" size="sm" />
                    </Button>
                  </div>
                )}
              </div>
            );
          })}
        </div>
      )
    }
  </div>
</section>


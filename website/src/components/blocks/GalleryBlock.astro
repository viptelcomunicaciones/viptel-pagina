---
import type { GalleryBlock as GalleryBlockType } from '@/lib/payload-types'

interface Props {
  block: GalleryBlockType
  locale?: string
}

const { block } = Astro.props
---

<section class="relative z-10 py-[var(--space-section-md)] bg-background border-t border-border">
  <div class="mx-auto max-w-6xl px-6">
    {block.heading && (
      <h2 class="font-display text-3xl md:text-4xl font-bold text-foreground text-center mb-12" data-reveal>{block.heading}</h2>
    )}
    <div class="grid gap-4 grid-cols-2 md:grid-cols-3 lg:grid-cols-4">
      {block.images.map((img, i) => (
        <div class="group relative overflow-hidden rounded-xl aspect-square" data-reveal data-reveal-delay={(i % 4) || undefined}>
          <img
            src={img.image?.url}
            alt={img.alt || img.image?.alt || ''}
            class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
          />
          {img.caption && (
            <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/60 to-transparent p-4 opacity-0 group-hover:opacity-100 transition-opacity">
              <p class="text-white text-sm">{img.caption}</p>
            </div>
          )}
        </div>
      ))}
    </div>
  </div>
</section>

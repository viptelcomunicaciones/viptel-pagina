---
/**
 * ServicesOverviewView — the /services listing page.
 * Shows all service categories with their sub-services as cards.
 */
import PageLayout from '@/layouts/PageLayout.astro';
import Button from '@/components/ui/form/Button/Button.astro';
import Badge from '@/components/ui/data-display/Badge/Badge.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import CTA from '@/components/ui/marketing/CTA/CTA.astro';
import ServiceCard from '@/components/services/ServiceCard.astro';
import { Hero } from '@/components/hero';
import { t, localizedPath } from '@/i18n';
import type { Service } from '@/lib/payload-types';

interface Props {
  categories: Service[];
  childrenMap: Record<string, Service[]>;
  hrefPrefix?: string;
  locale?: string;
}

const { categories, childrenMap, hrefPrefix = '/services', locale = 'es' } = Astro.props;
---

<PageLayout
  title={t('services.overview.hero.title', locale)}
  description={t('services.overview.hero.description', locale)}
>
  <Hero layout="centered" size="sm" class="isolate" showHeroHalo>
    <Badge slot="badge" variant="brand" pill>
      <Icon name="briefcase" size="sm" />
      {t('services.overview.hero.badge', locale)}
    </Badge>
    <h1 slot="title">{t('services.overview.hero.title', locale)}</h1>
    <p slot="description" class="!text-balance">
      {t('services.overview.hero.description', locale)}
    </p>
  </Hero>

  <section class="py-[var(--space-section-md)]">
    <div class="mx-auto max-w-6xl px-4">
      <div class="flex flex-col gap-16">
        {
          categories.map((category) => {
            const subs = childrenMap[category.id] || [];
            return (
              <div data-reveal>
                <div class="mb-6 flex items-center gap-4">
                  <h2 class="text-foreground text-xl font-bold">{category.title}</h2>
                  <span class="text-foreground-muted text-sm">
                    ({subs.length} {locale === 'es' ? 'servicios' : 'services'})
                  </span>
                </div>
                {category.shortDescription && (
                  <p class="text-foreground-muted mb-6">{category.shortDescription}</p>
                )}
                <div class="grid gap-4 sm:grid-cols-2">
                  {subs.map((sub) => (
                    <ServiceCard
                      service={sub}
                      href={`${hrefPrefix}/${category.slug}${sub.slug ? '/' + sub.slug : ''}`}
                    />
                  ))}
                </div>
              </div>
            );
          })
        }
      </div>
    </div>
  </section>

  <CTA variant="default" size="md" maxWidth="lg">
    <h2 slot="heading" class="!text-3xl">{t('services.overview.cta.title', locale)}</h2>
    <p slot="description" class="!text-lg text-balance">
      {t('services.overview.cta.description', locale)}
    </p>
    <div slot="actions">
      <Button href={localizedPath('/contact', locale)} size="lg">
        {t('services.overview.cta.button', locale)}
      </Button>
    </div>
  </CTA>
</PageLayout>
---
import PageLayout from '@/layouts/PageLayout.astro';
import BlockRenderer from '@/components/blocks/BlockRenderer.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import Badge from '@/components/ui/data-display/Badge/Badge.astro';
import Button from '@/components/ui/form/Button/Button.astro';
import { Hero } from '@/components/hero';
import TypingEffect from '@/components/ui/TypingEffect.astro';
import TechStack from '@/components/landing/TechStack.astro';
import LetterGlitchBand from '@/components/patterns/LetterGlitchBand.astro';
import { payload } from '@/lib/payload-client';
import { t, defaultLocale, localizedPath } from '@/i18n';
import type { PageBlock } from '@/lib/block-types';

interface Props {
  locale?: string;
}

const { locale = defaultLocale } = Astro.props;
const about = await payload.pages().getBySlug('about', locale);

function extractRichText(richText: any): string {
  try {
    const root = richText?.root;
    if (!root || !Array.isArray(root.children)) return '';
    return root.children
      .filter((c: any) => c.type === 'paragraph' || c.type === 'heading')
      .map((c: any) => c.children?.map((t: any) => t.text || '').join('') || '')
      .join(' ');
  } catch {
    return '';
  }
}

const heroTitle = extractRichText(about?.hero?.richText);
const contactUrl = localizedPath('/contact', locale);
---

<PageLayout
  title={about?.meta?.title || t('pages.about.meta.title', locale)}
  description={about?.meta?.description || t('pages.about.meta.description', locale)}
  footerBackground="secondary"
>
  <Hero layout="centered" size="sm" class="isolate" showHeroHalo>
    <Badge slot="badge" variant="brand" pill
      ><Icon name="rocket" size="sm" />{t('pages.about.hero.badge', locale)}</Badge
    >
    <h1 slot="title">
      {
        heroTitle ? (
          <span class="text-foreground [-webkit-text-fill-color:currentColor]">{heroTitle}</span>
        ) : (
          <>
            <>
              <span class="text-foreground [-webkit-text-fill-color:currentColor]">
                {t('pages.about.hero.titleLead', locale)}
              </span>
              <br />
            </>
            <span class="text-brand-500 [-webkit-text-fill-color:var(--color-brand-500)] sm:hidden">
              <TypingEffect words={['Telecomunicaciones', 'Desarrollo Web', 'Marketing Digital']} />
            </span>
            <span class="text-brand-500 hidden [-webkit-text-fill-color:var(--color-brand-500)] sm:inline">
              <TypingEffect
                words={[
                  'Telecomunicaciones',
                  'Desarrollo Web',
                  'Marketing Digital',
                  'Transformación Digital',
                ]}
              />
            </span>
          </>
        )
      }
    </h1>
    <p slot="description" class="text-balance!">{t('pages.about.hero.description', locale)}</p>
  </Hero>

  <!-- CMS Layout Blocks -->
  {
    about?.layout && about.layout.length > 0 ? (
      <BlockRenderer layout={about.layout as PageBlock[]} locale={locale} />
    ) : (
      <div class="text-foreground-muted bg-background-secondary border-border border-t py-24 text-center">
        <p class="text-lg">Edita la pagina "about" desde el panel de administracion.</p>
      </div>
    )
  }

  <!-- Tech Stack (static) -->
  <TechStack
    badge="Tecnologia"
    badgeIcon="wrench"
    title="Tecnologias que utilizamos"
    description="Un stack moderno para soluciones empresariales de alto rendimiento."
    background="secondary"
  />

  <!-- CTA -->
  <section class="bg-background border-border relative z-10 border-t py-[var(--space-section-md)]">
    <div class="glitch:hidden mx-auto max-w-2xl px-6 text-center" data-reveal>
      <Badge variant="brand" pill class="mb-6"><Icon name="rocket" size="sm" />Contactanos</Badge>
      <h2 class="font-display text-foreground mb-4 text-4xl font-bold text-balance">
        Listo para trabajar con nosotros?
      </h2>
      <p class="text-foreground-muted mb-8 text-lg text-balance">
        Cuentanos tu proyecto y te ayudamos a encontrar la solucion ideal.
      </p>
      <Button size="lg" href={contactUrl} class="cta-btn-brand"
        >Contactanos<Icon name="arrow-right" size="sm" /></Button
      >
    </div>
    <LetterGlitchBand>
      <h2 class="font-display text-foreground mb-4 text-4xl font-bold text-balance">
        Listo para trabajar con nosotros?
      </h2>
      <p class="text-foreground-muted mb-8 text-lg text-balance">
        Cuentanos tu proyecto y te ayudamos a encontrar la solucion ideal.
      </p>
      <Button size="lg" href={contactUrl} class="hero-btn-brand"
        >Contactanos<Icon name="arrow-right" size="sm" /></Button
      >
    </LetterGlitchBand>
  </section>
</PageLayout>

<style>
  details[open] > summary .faq-icon {
    transform: rotate(180deg);
  }
</style>

---
/**
 * HomeView — the landing page body, CMS-driven.
 *
 * Fetches the "home" page from Payload CMS and renders:
 * - Hero (Astro design: typing effect, stack marquee, CTAs from Payload)
 * - Layout blocks via BlockRenderer (editable from Payload admin)
 *
 * Shared by the default-locale route (`/`) and the locale-prefixed
 * route (`/<locale>`).
 */
import LandingLayout from '@/layouts/LandingLayout.astro';
import RenderHero from '@/components/heros/RenderHero.astro';
import BlockRenderer from '@/components/blocks/BlockRenderer.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import StackMarquee from '@/components/landing/StackMarquee.astro';
import type { StackItem } from '@/components/landing/StackMarquee.astro';
import { viptelStack } from '@/data/stack';
import { payload } from '@/lib/payload-client';
import { t, defaultLocale } from '@/i18n';
import type { PageBlock } from '@/lib/block-types';

interface Props {
  locale?: string;
}

const { locale = defaultLocale } = Astro.props;

const home = await payload.pages().getBySlug('home', locale);

const heroImageUrl =
  home?.hero?.media && typeof home.hero.media !== 'number' && home.hero.media.url
    ? payload.resolveMediaUrl(home.hero.media.url)
    : null;

const heroStackOrder = [
  'Astro',
  'Tailwind CSS',
  'TypeScript',
  'React',
  'GitHub',
  'Vercel',
  'Claude',
];
const heroStackItems = viptelStack
  .filter((e: StackItem) => heroStackOrder.includes(e.name))
  .sort((a, b) => heroStackOrder.indexOf(a.name) - heroStackOrder.indexOf(b.name));

const metaImageUrl =
  home?.meta?.image && typeof home.meta.image === 'object' && home.meta.image.url
    ? payload.resolveMediaUrl(home.meta.image.url)
    : heroImageUrl || '/og-default.svg';
---

<LandingLayout
  title={home?.meta?.title || t('pages.home.meta.title', locale)}
  description={home?.meta?.description || t('pages.home.meta.description', locale)}
  image={metaImageUrl}
  headerStyle={home?.headerStyle ?? 'floating'}
  floatingVariant={home?.floatingVariant}
  hasDarkHero={home?.hero?.type === 'highImpact'}
  includePersonSchema={true}
  includeProfessionalServiceSchema={true}
>
  <!-- Hero: Render CMS Hero with all variants support -->
  {home?.hero && <RenderHero hero={home.hero} locale={locale} />}

  <!-- Tech Stack Marquee (Identidad visual Viptel) -->
  <div class="hp-hero-marquee-section relative z-10 mx-auto w-full max-w-6xl px-6 py-6" aria-hidden="true">
    <div class="hp-hero-marquee">
      <StackMarquee
        items={heroStackItems}
        rows={1}
        duration={55}
        pauseOnHover={false}
        linked={false}
        cardWidth="auto"
        gap="1rem"
      />
    </div>
    <div class="hp-hero-logos">
      {heroStackItems.slice(0, 4).map((item) => (
        <span class="hp-hero-logo">
          <Icon name={item.icon} size="lg" />
        </span>
      ))}
    </div>
  </div>

  <!-- CMS Layout Blocks -->
  {
    home?.layout && home.layout.length > 0 ? (
      <BlockRenderer layout={home.layout as PageBlock[]} locale={locale} />
    ) : (
      <div class="text-foreground-muted bg-background-secondary border-border border-t py-24 text-center">
        <Icon name="layout" size="lg" class="mx-auto mb-4 opacity-40" />
        <p class="text-lg">No hay contenido configurado en la página de inicio.</p>
        <p class="mt-2 text-sm">
          Edita la página "home" desde el panel de administración de Payload.
        </p>
      </div>
    )
  }
</LandingLayout>

<style is:global>
  @media (min-width: 768px) {
    .hero-dark-gradient .hero-title-slot + div {
      max-width: 48rem;
    }
  }

  .hp-hero-marquee .stack-marquee-item > * {
    background: transparent;
    border-color: transparent;
    box-shadow: none;
    padding-left: var(--space-3);
    padding-right: var(--space-3);
  }
  .hp-hero-marquee .stack-marquee-item .font-display {
    font-weight: 500;
    color: var(--color-foreground-muted);
  }

  section.hero-dark-gradient {
    --hero-floor-gap: var(--space-16);
    padding-bottom: var(--space-16);
  }
  .hp-hero-marquee {
    pointer-events: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hp-hero-marquee {
      animation: hp-hero-marquee-fade 0.6s ease-out 1.2s backwards;
    }
  }
  @keyframes hp-hero-marquee-fade {
    from {
      opacity: 0.01;
    }
    to {
      opacity: 1;
    }
  }

  @media (max-width: 767px) {
    .hp-hero-marquee {
      display: none;
    }
  }
  @media (orientation: landscape) and (max-height: 500px) and (pointer: coarse) {
    .hp-hero-marquee {
      display: none;
    }
  }

  .hp-hero-logos {
    display: none;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    pointer-events: none;
  }
  @media (max-width: 767px) and (orientation: portrait) {
    .hp-hero-logos {
      display: flex;
      padding-bottom: 2rem;
    }
  }

  .hp-hero-logo {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    border-radius: 9999px;
    color: var(--color-brand-500);
    background: color-mix(in oklch, var(--color-brand-500) 12%, transparent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .hp-hero-logos {
      animation: hp-hero-marquee-fade 0.6s ease-out 1.2s backwards;
    }
  }
</style>

# Database (use your own local credentials — never commit real ones)
DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5432/payload_viptel

# Payload
PAYLOAD_SECRET=change-me-generate-a-long-random-string
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000

# Astro frontend (CORS + preview URLs + SEO generateURL)
FRONTEND_URL=http://localhost:4321

# Preview mode — must match PREVIEW_SECRET in website/.env
PREVIEW_SECRET=change-me-shared-with-website

# Cron jobs (Authorization: Bearer <CRON_SECRET> for /api/payload-jobs/run)
CRON_SECRET=change-me-cron-secret

# Email via Resend (optional — email adapter is disabled when unset)
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=noreply@viptelcomunicaciones.com

# Media uploads directory (optional — defaults to public/media)
# MEDIA_PATH=

# Seed script (optional overrides)
# SEED_ADMIN_EMAIL=admin@viptelcomunicaciones.com
# SEED_ADMIN_PASSWORD=viptel-dev-password
